def lgit(cwd, *args, env=None, check=True, data=None):
    p = subprocess.run(["git", "-C", cwd] + list(args), capture_output=True, env=env, input=data)
    if check and p.returncode != 0:
        die("git %s failed: %s" % (" ".join(args[:2]), p.stderr.decode(errors="replace").strip()[-600:]))
    return p


def lgit_out(cwd, *args, env=None):
    return lgit(cwd, *args, env=env).stdout.decode().strip()


def local_tree(top, gitdir, index, includes=()):
    """Tree id of the files as `git add -A` would stage them, plus the INCLUDES ignored files.
    The sandbox computes the same id."""
    tmp = os.path.join(gitdir, "fx-cloud-index.%d" % os.getpid())
    try:
        if os.path.exists(index):
            shutil.copyfile(index, tmp)
        env = dict(os.environ, GIT_INDEX_FILE=tmp)
        lgit(top, "add", "-A", "--", ".", *TLC_PATHSPECS, env=env)
        if includes:
            lgit(top, "add", "-f", "--pathspec-from-file=-", "--pathspec-file-nul", env=env,
                 data="\0".join(includes).encode())
        return lgit_out(top, "write-tree", env=env)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def encode_list(items):
    if not items:
        return "-"
    arg = "b64:" + base64.b64encode("\0".join(items).encode()).decode()
    if len(arg) > INLINE_LIMIT:
        die("too many included files (%d); name fewer with --include or .fx-cloud-include" % len(items))
    return arg


def collect_includes(top, cwd, extra):
    """Ignored files to copy anyway: paths from .fx-cloud-include at the worktree top, one per line,
    and from --include, relative to the current folder."""
    specs = []
    listed = os.path.join(top, ".fx-cloud-include")
    if os.path.isfile(listed):
        with open(listed) as f:
            specs += [s.strip() for s in f if s.strip() and not s.strip().startswith("#")]
    for e in extra:
        rel = os.path.relpath(os.path.realpath(os.path.join(cwd, e)), top)
        if rel == ".." or rel.startswith(".." + os.sep):
            die("--include %s is outside the worktree %s" % (e, top))
        specs.append(rel)
    if not specs:
        return []
    out = lgit(top, "ls-files", "-z", "-o", "-i", "--exclude-standard", "--", *specs).stdout
    files = sorted(set(x.decode() for x in out.split(b"\0") if x))
    total = sum(os.path.getsize(os.path.join(top, f)) for f in files if os.path.isfile(os.path.join(top, f)))
    if len(files) > 5000 or total > PLAIN_LIMIT:
        die("the included ignored files are too large (%d files, %s); name fewer" % (len(files), human(total)))
    return files


def local_state(path, extra_includes=()):
    """The Mac worktree around PATH, or None outside git. Uses few git calls, because each one
    costs about 0.1 s on a busy Mac; the copy-only parts come later from copy_info()."""
    cwd = os.path.realpath(path)
    p = subprocess.run(["git", "-C", cwd, "rev-parse", "--show-toplevel", "--absolute-git-dir",
                        "--git-path", "index", "HEAD"], capture_output=True)
    lines = p.stdout.decode().splitlines()
    if p.returncode != 0:
        if len(lines) >= 2:  # a repository, but HEAD does not resolve
            die("%s has no commit yet; fx-cloud copies worktrees that have at least one commit" % lines[0])
        return None
    top, gitdir, index, sha = os.path.realpath(lines[0]), lines[1], lines[2], lines[3]
    if not os.path.isabs(index):
        index = os.path.join(cwd, index)
    includes = collect_includes(top, cwd, extra_includes)
    return {
        "top": top, "cwd": cwd, "sha": sha, "tree": local_tree(top, gitdir, index, includes),
        "key": hashlib.sha1(top.encode()).hexdigest()[:12],
        "includes": includes, "inc_arg": encode_list(includes),
    }


def copy_info(st):
    """Adds what a copy needs: the commit that carries the Mac's files, and the origin URL."""
    if "cwip" in st:
        return st
    env = dict(os.environ, **FIXED_IDENTITY)
    # A fixed identity and date make the same files give the same commit id. Nothing on the Mac
    # points to this commit.
    st["cwip"] = lgit_out(st["top"], "-c", "commit.gpgSign=false", "commit-tree", "--no-gpg-sign",
                          st["tree"], "-p", st["sha"], "-m", "fx-cloud copy", env=env)
    origin = lgit(st["top"], "config", "--get", "remote.origin.url", check=False)
    st["origin"] = origin.stdout.decode().strip() if origin.returncode == 0 else ""
    return st


def helper_script(op, *args):
    return 'python3 "$HOME/.local/share/fx-cloud/fxc-remote.py" %s %s %s' % (
        op, PROTOCOL, " ".join(shlex.quote(a) for a in args))


def upload_helper():
    say("updating the sandbox helper")
    rc = subprocess.call(vercel("copy", os.path.join(HERE, "remote", "fxc-remote.py"),
                                "%s:%s" % (SANDBOX, HELPER_REMOTE_PATH)),
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if rc != 0:
        die("could not update the sandbox helper; run fx-cloud setup --no-warm")


def kill_remote(pidfile):
    script = ('pg=$(cat %s 2>/dev/null) || exit 0; kill -TERM -- -"$pg" 2>/dev/null; '
              'sleep 3; kill -KILL -- -"$pg" 2>/dev/null; rm -f %s') % (pidfile, pidfile)
    subprocess.run(remote_cmd(script), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=60)


class Extender:
    """Keeps the sandbox session alive while fx-cloud uses it. The helper reports the session's
    uptime; the session ends at its timeout plus the time added so far, so add time before that."""

    @property
    def STATE(self):  # noqa: N802 - one clock file for each sandbox
        return os.path.join(STATE_DIR, "extend", (SANDBOX or "none") + ".json")

    def __init__(self):
        self.seen = None  # (boot id, uptime, local time when seen)
        self.worker = None
        self.lock = threading.Lock()

    def observe(self, clock):
        if clock.get("boot") and "uptime" in clock:
            self.seen = (clock["boot"], float(clock["uptime"]), time.time())
            self.check()

    def added(self, boot):
        try:
            with open(self.STATE) as f:
                d = json.load(f)
            return d.get("added_s", 0) if d.get("boot") == boot else 0
        except (OSError, ValueError):
            return 0

    def check(self):
        if not self.seen:
            return
        boot, uptime, seen_at = self.seen
        added = self.added(boot)
        left = SESSION_TIMEOUT_S + added - (uptime + time.time() - seen_at)
        with self.lock:
            if left >= EXTEND_WHEN_LEFT_S or (self.worker and self.worker.is_alive()):
                return
            self.worker = threading.Thread(target=self.extend, args=(boot, added), daemon=True)
            self.worker.start()

    def extend(self, boot, added):
        rc = subprocess.call(vercel("extend", SANDBOX, EXTEND_BY),
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if rc == 0:
            os.makedirs(os.path.dirname(self.STATE), exist_ok=True)
            with open(self.STATE, "w") as f:
                json.dump({"boot": boot, "added_s": added + EXTEND_BY_S}, f)
            if LEGACY or SANDBOX == FALLBACK:
                say("added %s to the sandbox session, which had less than %d minutes left"
                    % (EXTEND_BY, EXTEND_WHEN_LEFT_S // 60))
        else:
            say("could not add time to the sandbox session; your plan may limit one session's length")

    def finish(self):
        if self.worker:
            self.worker.join(timeout=30)


EXTENDER = Extender()


def remote_stream(script, capture=False, pidfile=None, _retry=True):
    """Runs a script in the sandbox. Its stdout streams to ours (or is captured), its stderr streams
    without the Vercel CLI banner, and FXC:: lines from the helper come back as results.
    A stop signal also stops the remote command. When an agent sandbox is gone, a new one starts
    and the script runs once more; the copy steps around it then fill the new sandbox."""
    p = subprocess.Popen(remote_cmd(script), stdout=subprocess.PIPE if capture else None,
                         stderr=subprocess.PIPE, start_new_session=True)
    results, before = [], []
    started, old_doc = [False], [False]
    spawned, exit_code, carry = [False], [None], [""]

    def pump():
        for raw in iter(p.stderr.readline, b""):
            line = carry[0] + raw.decode("utf-8", "replace")
            carry[0] = ""
            if line.endswith(TICK):
                carry[0] = line[:-len(TICK)]  # a partial line of the command, which the tick ended
                continue
            if old_doc[0]:
                continue
            if line.startswith("Sandbox half of `fx-cloud sync`"):
                # The helper from the first setup prints this usage text for any op it lacks.
                old_doc[0] = True
                results.append({"error": "old_helper"})
                continue
            if line.startswith("FXC::"):
                try:
                    result = json.loads(line[5:])
                except ValueError:
                    continue
                if "uptime" in result:
                    spawned[0] = True
                    EXTENDER.observe(result)  # the session clock, sent as a command starts
                elif "exit" in result:
                    exit_code[0] = result["exit"]
                else:
                    results.append(result)
                continue
            if not started[0]:
                if line.startswith("$ "):
                    started[0] = True  # the CLI echoes the command; remote output follows
                else:
                    before.append(line)
                continue
            sys.stderr.write(line)
            sys.stderr.flush()
        if carry[0] and started[0]:
            sys.stderr.write(carry[0])
            sys.stderr.flush()

    reader = threading.Thread(target=pump, daemon=True)
    reader.start()
    stopped = []

    def on_signal(signum, _frame):
        if stopped:
            return
        stopped.append(signum)
        say("stopping the command in the sandbox")
        if pidfile:
            try:
                kill_remote(pidfile)
            except Exception:  # noqa: BLE001
                pass
        p.terminate()

    done = threading.Event()

    def tick():  # long commands keep the session alive; check well before the threshold passes
        while not done.wait(max(30, min(300, EXTEND_WHEN_LEFT_S // 3))):
            EXTENDER.check()

    threading.Thread(target=tick, daemon=True).start()
    old = {s: signal.signal(s, on_signal) for s in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP)}
    try:
        out = p.stdout.read() if capture else b""
        rc = p.wait()
    finally:
        done.set()
        for s, h in old.items():
            signal.signal(s, h)
    reader.join(timeout=5)
    EXTENDER.finish()
    if not started[0] and rc != 0 and not results:
        text = "".join(before)
        if (_retry and not stopped and SANDBOX.startswith(AGENT_PREFIX)
                and "not found for this project" in text):
            restart_sandbox()
            return remote_stream(script, capture=capture, pidfile=pidfile, _retry=False)
        sys.stderr.write(text)
    if stopped:
        rc = 128 + stopped[0]
    elif spawned[0] and exit_code[0] is None:
        # Never pass on the CLI's own code here: it has been 0 for a lost stream.
        say("the connection to the sandbox closed before the command ended, so its later output "
            "and its exit code are lost; the command may still be running in the sandbox")
        rc = LOST_STREAM
    return rc, results, out


def is_old_helper(rc, last):
    return rc in (2, OLD_HELPER) and last.get("error") == "old_helper"


def helper_call(op, *args, capture=False):
    """One helper op, with one retry after updating an old helper."""
    for attempt in range(2):
        rc, results, out = remote_stream(helper_script(op, *args), capture=capture)
        last = results[-1] if results else {}
        if attempt == 0 and is_old_helper(rc, last):
            upload_helper()
            continue
        return rc, results, out


def mac_excludes(top):
    """The Mac's ignore rules for this repository: its info/exclude and the global excludes file."""
    parts = []
    common = lgit_out(top, "rev-parse", "--git-common-dir")
    if not os.path.isabs(common):
        common = os.path.join(top, common)
    gx = lgit(top, "config", "--path", "core.excludesFile", check=False).stdout.decode().strip()
    if not gx:
        gx = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"), "git", "ignore")
    for path in (os.path.join(common, "info", "exclude"), os.path.expanduser(gx)):
        if os.path.isfile(path):
            with open(path, errors="replace") as f:
                parts.append(f.read())
    return "\n".join(parts)


def default_remote_ref(top):
    for ref in ("refs/remotes/origin/HEAD", "refs/remotes/origin/main", "refs/remotes/origin/master"):
        if lgit(top, "rev-parse", "--verify", "-q", ref, check=False).returncode == 0:
            return ref
    return None


def make_bundle(st, strategy, path):
    ref = "refs/fx-cloud/" + st["key"]
    lgit(st["top"], "update-ref", ref, st["cwip"])
    try:
        args = ["bundle", "create", "-q", path, ref]
        if strategy == "remotes":
            args += ["--not", "--remotes=origin"]
        elif strategy == "merge-base":
            base_ref = default_remote_ref(st["top"])
            if not base_ref:
                return False
            mb = lgit(st["top"], "merge-base", st["sha"], base_ref, check=False)
            if mb.returncode != 0:
                return False
            args += ["--not", mb.stdout.decode().strip()]
        lgit(st["top"], *args)
        return True
    finally:
        lgit(st["top"], "update-ref", "-d", ref, check=False)


INLINE_LIMIT = 48 * 1024
PUSH_CACHE = os.path.join(HOME, ".cache", "fx-cloud", "pushed")


def cache_path(st):
    return os.path.join(PUSH_CACHE, SANDBOX, st["key"] + ".json")


def cache_says_synced(st):
    """True when the last successful sandbox call saw exactly this commit and these files."""
    try:
        with open(cache_path(st)) as f:
            c = json.load(f)
        return c.get("sha") == st["sha"] and c.get("tree") == st["tree"]
    except (OSError, ValueError):
        return False


def remember_synced(st):
    os.makedirs(os.path.dirname(cache_path(st)), exist_ok=True)
    tmp = cache_path(st) + ".tmp"
    with open(tmp, "w") as f:
        json.dump({"sha": st["sha"], "tree": st["tree"], "top": st["top"]}, f)
    os.replace(tmp, cache_path(st))


def forget_synced(st):
    try:
        os.unlink(cache_path(st))
    except OSError:
        pass


def copy_payload(st, strategy, tmp):
    """The bundle and ignore rules for `apply`: inline in the command when small, else uploaded.
    Returns (bundle_arg, exclude_arg, cleanup, size), or None when STRATEGY cannot build a bundle."""
    path = os.path.join(tmp, "copy.bundle")
    if not make_bundle(st, strategy, path):
        return None
    exclude = mac_excludes(st["top"]).encode()
    exclude_arg = ("b64:" + base64.b64encode(exclude).decode()) if len(exclude) <= INLINE_LIMIT else "-"
    size = os.path.getsize(path)
    if size <= INLINE_LIMIT:
        with open(path, "rb") as f:
            return "b64:" + base64.b64encode(f.read()).decode(), exclude_arg, "", size
    remote = "/tmp/fxc-push-%s.bundle" % st["key"]
    say("uploading %s of commits and changes" % human(size))
    rc = subprocess.call(vercel("copy", path, "%s:%s" % (SANDBOX, remote)),
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if rc != 0:
        die("upload to the sandbox failed")
    return remote, exclude_arg, "; rc=$?; rm -f %s; exit $rc" % remote, size


def report_sandbox_changed(files):
    say("the sandbox copy has changes that are not on the Mac, so it was not overwritten:")
    for line in files[:20]:
        print("    " + line.replace("\t", " "), file=sys.stderr)
    if len(files) > 20:
        print("    ... and %d more" % (len(files) - 20), file=sys.stderr)
    say("see them with `fx-cloud pull --patch`, take them with `fx-cloud pull --patch --apply`, "
        "or discard them with `--force`")


def run_plain(script, capture):
    """Runs SCRIPT in the sandbox without copying anything."""
    for attempt in range(2):
        pidfile = "/tmp/fxc-runs/%s.pid" % uuid.uuid4().hex
        rc, results, out = remote_stream(
            helper_script("run", "-", os.path.realpath(os.getcwd()), "-", "-", "-", "-", pidfile, script),
            capture=capture, pidfile=pidfile)
        if attempt == 0 and is_old_helper(rc, results[-1] if results else {}):
            upload_helper()
            continue
        return rc, out


def run_checked_and_ran(st, script, capture=False, force=False):
    """Runs SCRIPT in the sandbox copy of the worktree. When the copy may differ from the Mac, the
    same sandbox call first makes it match, so a changed worktree usually costs one call. Returns
    (rc, out, ran); ran is False when the sandbox did not start SCRIPT."""
    if st is None:
        return run_plain(script, capture) + (True,)
    strategies = None
    copy = force or not cache_says_synced(st)
    helper_updated = False
    for _ in range(6):
        pidfile = "/tmp/fxc-runs/%s.pid" % uuid.uuid4().hex
        run = helper_script("run", st["top"], st["cwd"], st["sha"], st["tree"], st.get("cwip", "-"),
                            st["inc_arg"], pidfile, script)
        with tempfile.TemporaryDirectory() as tmp:
            remote = run
            if copy:
                copy_info(st)
                if strategies is None:
                    strategies = ["remotes", "merge-base", "full"] if st["origin"] else ["full"]
                payload = None
                while strategies and payload is None:
                    payload = copy_payload(st, strategies[0], tmp)
                    if payload is None:
                        strategies.pop(0)
                if payload is None:
                    die("cannot send the commits to the sandbox")
                bundle_arg, exclude_arg, cleanup, size = payload
                say("copying %s to the sandbox (%s)" % (st["top"], human(size)))
                apply = helper_script("apply", st["top"], st["sha"], st["tree"], st["cwip"], st["inc_arg"],
                                      st["origin"], bundle_arg, exclude_arg, "1" if force else "0")
                remote = "(" + apply + " && " + run + ")" + cleanup
            rc, results, out = remote_stream(remote, capture=capture, pidfile=pidfile)
        last = results[-1] if results else {}
        if not helper_updated and is_old_helper(rc, last):
            upload_helper()
            helper_updated = True
            continue
        changed = next((r for r in results if "sandbox_changed" in r), None)
        if changed:
            forget_synced(st)
            report_sandbox_changed(changed["sandbox_changed"])
            return 1, out, False
        err = next((r for r in results if r.get("error")), None)
        if err and err["error"] == "prerequisite" and strategies and len(strategies) > 1:
            strategies.pop(0)  # the sandbox lacks commits the bundle builds on; send more history
            continue
        if err:
            forget_synced(st)
            say("sandbox: %s %s" % (err["error"], err.get("detail", "")))
            return 1, out, False
        if rc == NEEDS_PUSH and last.get("needs_push"):
            if copy:
                die("the sandbox copy still differs after copying; run with --force")
            copy = True  # the remembered state was stale
            continue
        applied = next((r for r in results if r.get("ok")), None)
        if applied and not applied.get("tree_match", True):
            say("note: the sandbox copy differs from the Mac in ignored or special files")
        remember_synced(st)
        return rc, out, True
    die("the sandbox copy did not settle after several tries")


def run_checked(st, script, capture=False, force=False):
    """Runs SCRIPT like run_checked_and_ran, and returns only (rc, out)."""
    rc, out, _ = run_checked_and_ran(st, script, capture=capture, force=force)
    return rc, out


PLAIN_CACHE = os.path.join(HOME, ".cache", "fx-cloud", "plain")


def plain_state(path):
    """A folder that is not a git worktree: its files (without build folders), their hashes, and
    one digest of all of them. Hashes are reused while a file's size and time stay the same."""
    root = os.path.realpath(path)
    refused = {"/", HOME, os.path.dirname(HOME), "/Users", "/tmp", "/private", "/private/tmp", "/var",
               "/private/var", os.path.realpath(tempfile.gettempdir())}
    if root in refused:
        die("will not copy %s to the sandbox; run fx-cloud from a project folder" % root)
    key = hashlib.sha1(root.encode()).hexdigest()[:12]
    cache_file = os.path.join(PLAIN_CACHE, key + ".hashes.json")
    try:
        with open(cache_file) as f:
            cache = json.load(f)
    except (OSError, ValueError):
        cache = {}
    manifest, fresh, total = {}, {}, 0
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = sorted(d for d in dirnames if d not in PLAIN_SKIP and not (
            os.path.basename(dirpath) == "states" and re.match(r"\d\d-\d\d-\d\d-", d)))  # TLC state folders
        for name in filenames:
            if name in PLAIN_SKIP:
                continue
            full = os.path.join(dirpath, name)
            try:
                st = os.lstat(full)
            except OSError:
                continue
            if not (st.st_mode & 0o170000 == 0o100000):
                continue  # regular files only
            total += st.st_size
            if total > PLAIN_LIMIT:
                die("%s holds more than %s without its build folders; fx-cloud copies folders outside git "
                    "only up to that size. Make it a git repository, or run from a smaller folder."
                    % (root, human(PLAIN_LIMIT)))
            rel = os.path.relpath(full, root)
            stamp = [st.st_size, st.st_mtime_ns]
            old = cache.get(rel)
            if old and old[:2] == stamp:
                digest = old[2]
            else:
                h = hashlib.sha256()
                with open(full, "rb") as f:
                    for chunk in iter(lambda: f.read(1 << 20), b""):
                        h.update(chunk)
                digest = h.hexdigest()
            fresh[rel] = stamp + [digest]
            manifest[rel] = [digest, 1 if st.st_mode & 0o111 else 0]
    os.makedirs(PLAIN_CACHE, exist_ok=True)
    with open(cache_file + ".tmp", "w") as f:
        json.dump(fresh, f)
    os.replace(cache_file + ".tmp", cache_file)
    digest = hashlib.sha256(json.dumps(sorted(manifest.items())).encode()).hexdigest()
    return {"root": root, "cwd": root, "key": key, "manifest": manifest, "digest": digest, "bytes": total}


def run_checked_plain(ps, script, capture=False, force=False):
    """Runs SCRIPT in a one-way copy of a plain folder. Only changed files move; files that the
    sandbox made are kept unless the Mac has a file at the same path."""
    sent_file = os.path.join(PLAIN_CACHE, SANDBOX, ps["key"] + ".sent.json")
    try:
        with open(sent_file) as f:
            sent = json.load(f)
    except (OSError, ValueError):
        sent = {}
    copy = force or sent.get("digest") != ps["digest"]
    full = force or not sent
    helper_updated = False
    for _ in range(5):
        pidfile = "/tmp/fxc-runs/%s.pid" % uuid.uuid4().hex
        run = helper_script("runplain", ps["root"], ps["cwd"], ps["digest"], pidfile, script)
        remote, cleanup = run, ""
        with tempfile.TemporaryDirectory() as tmp:
            if copy:
                base = {} if full else sent.get("manifest", {})
                changed = sorted(r for r, v in ps["manifest"].items() if base.get(r) != v)
                deleted = sorted(r for r in base if r not in ps["manifest"])
                tar_arg = "-"
                if changed:
                    tgz = os.path.join(tmp, "plain.tgz")
                    with tarfile.open(tgz, "w:gz") as tar:
                        for rel in changed:
                            tar.add(os.path.join(ps["root"], rel), arcname=rel, recursive=False)
                    size = os.path.getsize(tgz)
                    if size <= INLINE_LIMIT:
                        with open(tgz, "rb") as f:
                            tar_arg = "b64:" + base64.b64encode(f.read()).decode()
                    else:
                        tar_arg = "/tmp/fxc-plain-%s.tgz" % ps["key"]
                        rc = subprocess.call(vercel("copy", tgz, "%s:%s" % (SANDBOX, tar_arg)),
                                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                        if rc != 0:
                            die("upload to the sandbox failed")
                        cleanup = "; rc=$?; rm -f %s; exit $rc" % tar_arg
                say("copying %d changed file(s) of %s to the sandbox, one way (not a git worktree)"
                    % (len(changed), ps["root"]))
                apply = helper_script("applyplain", ps["root"], ps["digest"],
                                      "-" if full else sent.get("digest", "-"), tar_arg, encode_list(deleted))
                remote = "(" + apply + " && " + run + ")" + cleanup
            rc, results, out = remote_stream(remote, capture=capture, pidfile=pidfile)
        last = results[-1] if results else {}
        if not helper_updated and is_old_helper(rc, last):
            upload_helper()
            helper_updated = True
            continue
        err = next((r for r in results if r.get("error")), None)
        if err:
            say("sandbox: %s %s" % (err["error"], err.get("detail", "")))
            return 1, out
        if rc == NEEDS_PUSH and last.get("needs_push"):
            if copy and full:
                die("the sandbox copy still differs after a full copy")
            copy, full = True, bool(copy or last.get("needs_full") or last.get("remote_digest") != sent.get("digest"))
            continue
        os.makedirs(os.path.dirname(sent_file), exist_ok=True)
        with open(sent_file + ".tmp", "w") as f:
            json.dump({"digest": ps["digest"], "manifest": ps["manifest"]}, f)
        os.replace(sent_file + ".tmp", sent_file)
        return rc, out
    die("the sandbox copy did not settle after several tries")


def human(n):
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return ("%d %s" % (n, unit)) if unit == "B" else ("%.1f %s" % (n, unit))
        n /= 1024.0


def take_flags(args, flags, valued=(), multi=()):
    """Reads leading --flags; stops at the first other word or at --. MULTI flags take a value
    and may repeat; their values come back as a list."""
    got, rest = {}, list(args)
    while rest:
        a = rest[0]
        if a == "--":
            rest.pop(0)
            break
        if a in flags:
            got[a] = True
            rest.pop(0)
        elif a in multi and len(rest) > 1:
            got.setdefault(a, []).append(rest[1])
            del rest[:2]
        elif a in valued and len(rest) > 1:
            got[a] = rest[1]
            del rest[:2]
        else:
            break
    return got, rest


def run_here(script, flags, capture=False):
    """Runs SCRIPT in the sandbox copy of the current folder: a synced copy of a git worktree, or a
    one-way copy of a plain folder."""
    force = flags.get("--force", False)
    if flags.get("--no-push"):
        use_sandbox(folder_root(os.getcwd()))
        return run_checked(None, script, capture=capture)
    st = local_state(os.getcwd(), flags.get("--include", []))
    if st is not None:
        use_sandbox(st["top"])
        return run_checked(st, script, capture=capture, force=force)
    if flags.get("--include"):
        say("note: --include matters only in git worktrees; a plain folder copies all its files")
    ps = plain_state(os.getcwd())
    use_sandbox(ps["root"])
    return run_checked_plain(ps, script, capture=capture, force=force)


def run_here_and_ran(script):
    """Runs SCRIPT the way run_here(script, {}) does, and also says whether the sandbox started it.
    A plain folder always counts as started."""
    st = local_state(os.getcwd(), [])
    if st is None:
        rc, out = run_here(script, {})
        return rc, out, True
    use_sandbox(st["top"])
    return run_checked_and_ran(st, script)


def cmd_run(args):
    flags, rest = take_flags(args, ("--no-push", "--force"), multi=("--include",))
    if not rest:
        die("usage: fx-cloud run [--no-push] [--force] [--include PATH]... <command>", 2)
    script = rest[0] if len(rest) == 1 else shlex.join(rest)
    rc, _ = run_here(script, flags)
    return rc


def cmd_push(args):
    flags, _ = take_flags(args, ("--force",), multi=("--include",))
    rc, _ = run_here("true", flags)
    if rc == 0:
        say("the sandbox copy of %s matches the Mac" % os.path.realpath(os.getcwd()))
    return rc


def build_out(target):
    """The sandbox folder that a build for TARGET installs to before the copy to the Mac. It is
    the same every time: fx's build.zig puts the install folder in the test_paths options that the
    fx module imports, so a new folder would make Zig compile fx again. remote/base.sh warms the
    macOS one."""
    return "zig-out/.fx-cloud-" + re.sub(r"[^A-Za-z0-9_.-]", "_", target)


def mac_target():
    return "%s-macos" % ("aarch64" if platform.machine() == "arm64" else "x86_64")


def cmd_macos_build(args):
    """Builds the macOS binary of a Zig project, such as fx, in the sandbox, and puts it in the
    Mac worktree's zig-out/bin. The sandbox's own zig-out/bin keeps its Linux binary."""
    st = local_state(os.getcwd())
    if st is None:
        die("run fx-cloud macos-build from inside a git worktree of a Zig project")
    use_sandbox(st["top"])
    out = build_out(mac_target())
    script = "zig build -Dtarget=%s --prefix %s" % (mac_target(), out)
    if args:
        script += " " + shlex.join(args)
    rc, _ = run_checked(st, script)
    if rc != 0:
        return rc
    rc, results, _ = helper_call("tar", st["top"], out + "/bin")
    last = results[-1] if results else {}
    if rc != 0:
        die("sandbox: %s" % last.get("error", "exit %d" % rc))
    with tempfile.TemporaryDirectory() as tmp:
        tgz = os.path.join(tmp, "bin.tgz")
        if subprocess.call(vercel("copy", "%s:%s" % (SANDBOX, last["tarball"]), tgz),
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) != 0:
            die("download failed")
        count = extract_plain(tgz, os.path.join(st["top"], "zig-out"))
    say("the macOS build from the sandbox is in %s/zig-out/bin (%d %s)"
        % (st["top"], count, "file" if count == 1 else "files"))
    return 0


def cmd_agent(args):
    flags, rest = take_flags(args, ("--test-lane", "--no-push", "--force"), valued=("--resume",),
                             multi=("--include",))
    if not rest:
        die('usage: fx-cloud agent [--resume ID] [--test-lane] [--include PATH]... "<task>"', 2)
    task = " ".join(rest)
    fx = ["fx", "ask", "--json"]
    if flags.get("--resume"):
        fx += ["--resume", flags["--resume"], task]
    else:
        fx += [HANDOFF + task]
    if flags.get("--test-lane"):
        fx = ["aig", "test", "--fx-home"] + fx
    st = None if flags.get("--no-push") else local_state(os.getcwd(), flags.get("--include", []))
    say("handing the task to fx in the sandbox; its progress follows")
    rc, out = run_here(shlex.join(fx), flags, capture=True)
    try:
        result = json.loads(out.decode("utf-8", "replace"))
    except ValueError:
        sys.stdout.write(out.decode("utf-8", "replace"))
        say("fx in the sandbox returned no JSON result (exit %d)" % rc)
        return rc or 1
    print((result.get("final_output") or result.get("output") or "").rstrip())
    print()
    sid = result.get("session_id") or ""
    print("sandbox session: %s   exit: %s   steps: %s" % (sid or "(not saved)", result.get("exit_code", rc),
                                                         result.get("steps", "?")))
    if st:
        _, results, _ = helper_call("changes", st["top"])
        files = (results[-1] if results else {}).get("files", [])
        if files:
            print("changed in the sandbox copy (take them with `fx-cloud pull --patch --apply`):")
            for line in files[:40]:
                print("  " + line.replace("\t", " "))
        else:
            print("no files changed in the sandbox copy")
    elif not flags.get("--no-push"):
        print("this folder is not a git worktree, so its sandbox copy is one way; "
              "bring files back with `fx-cloud pull <path>`")
    if sid and not flags.get("--test-lane"):
        print("continue it with: fx-cloud agent --resume %s \"<next step>\"" % sid)
    return rc


def cmd_pull(args):
    flags, rest = take_flags(args, ("--patch", "--apply"))
    st = local_state(os.getcwd())
    root = st["top"] if st else os.path.realpath(os.getcwd())
    if use_sandbox(root, create=False) is None and not (LEGACY or SANDBOX == FALLBACK):
        die("this agent has no sandbox for %s, so there is nothing to pull" % root)
    if flags.get("--patch"):
        if st is None:
            die("run fx-cloud pull --patch from inside a git worktree")
        rc, results, patch = helper_call("patch", st["top"], capture=True)
        last = results[-1] if results else {}
        if rc != 0:
            die("sandbox: %s" % last.get("error", "exit %d" % rc))
        files = last.get("files", [])
        if not files:
            say("the sandbox copy has no changes since the last copy")
            return 0
        if not flags.get("--apply"):
            sys.stdout.buffer.write(patch)
            return 0
        check = subprocess.run(["git", "-C", st["top"], "apply", "--check", "--binary", "-"],
                               input=patch, capture_output=True)
        if check.returncode != 0:
            sys.stderr.write(check.stderr.decode(errors="replace"))
            die("the patch does not apply to the Mac worktree; nothing changed. "
                "See it with `fx-cloud pull --patch`.")
        lgit(st["top"], "apply", "--binary", "-", data=patch)
        say("applied the sandbox changes to %s:" % st["top"])
        for line in files:
            print("  " + line.replace("\t", " "))
        return 0
    if not rest:
        die("usage: fx-cloud pull --patch [--apply] | fx-cloud pull <path> [<dest>]", 2)
    src, dest = rest[0], (rest[1] if len(rest) > 1 else ".")
    rc, results, _ = helper_call("tar", os.path.realpath(os.getcwd()), src)
    last = results[-1] if results else {}
    if rc != 0:
        die("sandbox: %s" % last.get("error", "exit %d" % rc))
    with tempfile.TemporaryDirectory() as tmp:
        tgz = os.path.join(tmp, "pull.tgz")
        rc = subprocess.call(vercel("copy", "%s:%s" % (SANDBOX, last["tarball"]), tgz),
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if rc != 0:
            die("download failed")
        os.makedirs(dest, exist_ok=True)
        count = extract_plain(tgz, dest)
    say("copied %s to %s (%d %s)" % (src, dest, count, "file" if count == 1 else "files"))
    return 0


# --------------------------------------------------------------------------- zig and bun shims
#
# shims/zig and shims/bun come before the real tools in PATH on the Mac and call
# `fx-cloud zig|bun --real <path> -- <args>`. Heavy builds and tests run in the agent's sandbox;
# everything else, and every command with FXC_LOCAL=1, runs the real tool on the Mac.

# Repositories that link AppKit or use Swift build on the Mac. A name matches the origin URL.
LOCAL_ONLY_REPOS = ("fxd-zig", "fx-desktop", "fx-browser")
# zig build options that take their value as the next word.
ZIG_VALUE_OPTS = {"-p", "--prefix", "--prefix-lib-dir", "--prefix-exe-dir", "--prefix-include-dir",
                  "--sysroot", "--search-prefix", "--libc", "--build-file", "--cache-dir",
                  "--global-cache-dir", "--zig-lib-dir", "--build-runner", "--summary", "--seed",
                  "--maxrss", "--color", "--debug-log", "--test-timeout", "-j"}


def zig_build_parts(args):
    """(steps, prefix, target given) of `zig build` ARGS, which follow the word `build`."""
    steps, prefix, target, i = [], None, False, 0
    while i < len(args):
        a = args[i]
        if a == "--":
            break  # arguments for the program that a run step starts
        if a in ZIG_VALUE_OPTS:
            if a in ("-p", "--prefix") and i + 1 < len(args):
                prefix = args[i + 1]
            i += 2
            continue
        if a.startswith("--prefix="):
            prefix = a.split("=", 1)[1]
        elif a.startswith("-Dtarget="):
            target = True
        elif not a.startswith("-"):
            steps.append(a)
        i += 1
    return steps, prefix, target


def project_allows_remote(path):
    """False for folders fx-cloud must not copy and for repositories that build only on the Mac."""
    root = folder_root(path)
    if root in ("/", HOME, "/tmp", "/private/tmp") or root.startswith("/System"):
        return False
    origin = subprocess.run(["git", "-C", path, "config", "--get", "remote.origin.url"],
                            capture_output=True, text=True).stdout
    return not any(name in origin or ("/" + name) in root for name in LOCAL_ONLY_REPOS)


def zig_route(args):
    """local, remote-install (build the macOS binary there and copy it here), or remote-run."""
    if not args or args[0] not in ("build", "test"):
        return "local"
    if args[0] == "test":
        return "remote-run"
    rest = args[1:]
    if any(a in ("-h", "--help", "-l", "--list-steps", "--build-runner") for a in rest):
        return "local"  # help, step lists, and editor tooling
    steps, _, _ = zig_build_parts(rest)
    if "run" in steps:
        return "local"  # starts the program here, for hands-on use
    return "remote-install" if steps in ([], ["install"]) else "remote-run"


def bun_route(args):
    if not args:
        return "local"
    if args[0] == "test":
        return "remote-run"
    first = args[0][2:] if args[0].startswith("./") else args[0]
    if first.endswith((".ts", ".mjs", ".js")) and (
            "tests/" in first or (os.path.isfile(first) and "/tests/" in os.path.realpath(first))):
        return "remote-run"  # Bun drivers and harnesses under tests/, also from inside their folder
    return "local"


# The interpreters' own options that may come before the script; anything else (such as -c) means
# that no TLA+ runner script is given, so the call runs on the Mac.
TLA_OPTS = {
    "sh": {"-e", "-x", "-u", "-v", "-eu", "-ue", "-ex", "-xe", "-eux", "-xeu"},
    "bash": {"-e", "-x", "-u", "-v", "-eu", "-ue", "-ex", "-xe", "-eux", "-xeu"},
    "python3": {"-u", "-B", "-E", "-s", "-S", "-O"},
}


def git_toplevel(path):
    p = subprocess.run(["git", "-C", path, "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    return os.path.realpath(p.stdout.strip()) if p.returncode == 0 and p.stdout.strip() else None


def tla_route(tool, args):
    """remote-run when TOOL runs a script under tests/tla/ of the current git worktree, such as
    fx's TLA+ check.sh scripts and tests/tla/mcp/run.py; else local."""
    i = 0
    while i < len(args) and args[i] in TLA_OPTS.get(tool, ()):
        i += 1
    if i >= len(args) or args[i].startswith("-"):
        return "local"
    script = args[i]
    if not script.endswith(".py" if tool == "python3" else ".sh") or not os.path.isfile(script):
        return "local"
    top = git_toplevel(os.getcwd())
    if not top:
        return "local"
    rel = os.path.relpath(os.path.realpath(script), top)
    return "remote-run" if rel.startswith("tests/tla/") else "local"


# The run folder has the same path in the sandbox and on the Mac, so the paths that TLC prints work there.
LOGS_ROOT_FORMAT = "/tmp/fxc-tla-%d"
RUN_ID_CHARS = 8
SKIPPED_MANIFEST = ".fxc-skipped"  # must equal the one in remote/fxc-remote.py
PRIVATE_DIR_MODE = 0o700
PRIVATE_FILE_MODE = 0o600
BYTES_PER_KILOBYTE = 1024
BYTES_PER_MEGABYTE = 1024 * BYTES_PER_KILOBYTE
MAX_LOG_FILE_BYTES = 20 * BYTES_PER_MEGABYTE  # must equal LOG_FILE_LIMIT_BYTES in remote/fxc-remote.py
MAX_LOG_TOTAL_BYTES = 50 * BYTES_PER_MEGABYTE  # must equal LOG_TOTAL_LIMIT_BYTES in remote/fxc-remote.py
STALE_DOWNLOAD_SECONDS = 600  # a run killed mid-copy leaves its logs-*.tgz behind
COPY_TIMEOUT_SECONDS = 300  # the copy is at most 50 MB
REASON_MAX_CHARACTERS = 200


def run_dir_path(uid, run_id):
    return LOGS_ROOT_FORMAT % uid + "/" + run_id


def remote_script(command, run_dir, pack_command):
    return ('d=%s; if mkdir -p "$d"; then export TMPDIR="$d"; else echo "fx-cloud: could not make $d, so the logs of this run stay in the sandbox" >&2; fi; %s; rc=$?; { %s; } >/dev/null 2>&1; exit $rc'
            % (shlex.quote(run_dir), command, pack_command))


def prepare_logs_parent(path, uid):
    try:
        os.makedirs(path, mode=PRIVATE_DIR_MODE, exist_ok=True)
        info = os.lstat(path)
    except OSError:
        return False
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode) or info.st_uid != uid:
        return False
    try:
        os.chmod(path, PRIVATE_DIR_MODE)
    except OSError:
        return False
    return True


def is_inside(root, target):
    return target == root or target.startswith(root + os.sep)


def is_skipped_entry(entry):
    if not isinstance(entry, dict):
        return False
    path, size = entry.get("path"), entry.get("bytes")
    return isinstance(path, str) and isinstance(size, int) and not isinstance(size, bool)


def read_manifest(source):
    try:
        entries = json.loads(source.read().decode("utf-8"))
    except ValueError:
        return []
    if not isinstance(entries, list):
        return []
    return [(entry["path"], entry["bytes"]) for entry in entries if is_skipped_entry(entry)]


def write_log(source, target):
    os.makedirs(os.path.dirname(target), mode=PRIVATE_DIR_MODE, exist_ok=True)
    with open(target, "wb") as out:
        shutil.copyfileobj(source, out)
    os.chmod(target, PRIVATE_FILE_MODE)


def member_target(root, member):
    """The real path where MEMBER would be written under ROOT, or None when it leaves ROOT."""
    target = os.path.realpath(os.path.join(root, member.name))
    return target if is_inside(root, target) else None


def fits_limits(size, written_bytes):
    return size <= MAX_LOG_FILE_BYTES and written_bytes + size <= MAX_LOG_TOTAL_BYTES


def extract_folder(root, member):
    target = member_target(root, member)
    if target is not None:
        os.makedirs(target, mode=PRIVATE_DIR_MODE, exist_ok=True)


def extract_log(tar, member, root, written_bytes):
    """Writes a regular file under ROOT when it fits the limits. Returns True when it was written."""
    target = member_target(root, member)
    if target is None or not member.isreg() or not fits_limits(member.size, written_bytes):
        return False
    with tar.extractfile(member) as source:
        write_log(source, target)
    return True


def extract_logs(tgz, dest):
    count, refused, written_bytes, skipped = 0, 0, 0, []
    try:
        os.makedirs(dest, mode=PRIVATE_DIR_MODE, exist_ok=True)
        root = os.path.realpath(dest)
        with tarfile.open(tgz, "r:gz") as tar:
            for member in tar:
                if member.name == SKIPPED_MANIFEST and member.isreg():
                    skipped = read_manifest(tar.extractfile(member))
                elif member.isdir():
                    extract_folder(root, member)
                elif extract_log(tar, member, root, written_bytes):
                    count += 1
                    written_bytes += member.size
                else:
                    refused += 1
    except (tarfile.TarError, OSError, EOFError, zlib.error) as e:
        return count, skipped, refused, printable(str(e) or type(e).__name__)
    return count, skipped, refused, None


def printable(text):
    return "".join(ch if ch.isprintable() else escape_char(ch) for ch in text)


def escape_char(ch):
    code = ord(ch)
    return "\\x%02x" % code if code < 256 else "\\u%04x" % code


def char_bytes(ch):
    # A file name that is not UTF-8 holds its bytes as surrogates U+DC80..U+DCFF; other surrogates have no byte form.
    try:
        return ch.encode("utf-8", "surrogateescape")
    except UnicodeEncodeError:
        return ch.encode("utf-8", "surrogatepass")


def shell_escape_char(ch):
    if ch == "\\":
        return "\\\\"
    if ch == "'":
        return "\\'"
    if ch.isprintable():
        return ch
    return "".join("\\x%02x" % byte for byte in char_bytes(ch))


def shell_quote_printable(text):
    if text.isprintable():
        return shlex.quote(text)
    return "$'" + "".join(shell_escape_char(ch) for ch in text) + "'"


def human_size(byte_count):
    if byte_count >= BYTES_PER_MEGABYTE:
        # Rounds up, so a file over a limit never prints as the limit.
        tenths = -(-byte_count * 10 // BYTES_PER_MEGABYTE)
        return "%d.%d MB" % divmod(tenths, 10)
    if byte_count >= BYTES_PER_KILOBYTE:
        return "%d KB" % max(1, byte_count // BYTES_PER_KILOBYTE)
    return "%d bytes" % byte_count


def skipped_note(path_and_bytes, run_dir):
    relpath, byte_count = path_and_bytes
    full = run_dir + "/" + relpath
    if byte_count > MAX_LOG_FILE_BYTES:
        reason = "is too large to copy back (%s; the limit is %d MB for one file)" % (
            human_size(byte_count), MAX_LOG_FILE_BYTES // BYTES_PER_MEGABYTE)
    else:
        reason = "did not fit in the copy (%s; the limit is %d MB for all logs of one run)" % (
            human_size(byte_count), MAX_LOG_TOTAL_BYTES // BYTES_PER_MEGABYTE)
    return "%s %s; get it with: fx-cloud pull %s <dest>" % (printable(full), reason, shell_quote_printable(full))


def refused_note(refused, run_dir):
    return "left out %d %s from the sandbox that %s not plain log files under %s" % (
        refused, "entry" if refused == 1 else "entries", "was" if refused == 1 else "were", run_dir)


def log_notes(count, skipped, refused, run_dir):
    notes = []
    if count > 0:
        notes.append("copied %d TLC log %s to %s" % (count, "file" if count == 1 else "files", run_dir))
    notes.extend(skipped_note(entry, run_dir) for entry in skipped)
    if refused > 0:
        notes.append(refused_note(refused, run_dir))
    return notes


def remove_quietly(path):
    with contextlib.suppress(OSError):
        os.remove(path)


def failure_reason(stderr, returncode):
    lines = [line.strip() for line in stderr.splitlines() if line.strip()]
    if not lines:
        return "exit %d" % returncode
    return printable(lines[-1])[:REASON_MAX_CHARACTERS]


def fetch_logs(run_dir, tgz):
    """Copies the run's tarball from the sandbox to TGZ. Returns (ok, reason); reason is "" when ok."""
    try:
        done = subprocess.run(vercel("copy", "%s:%s.tgz" % (SANDBOX, run_dir), tgz),
                              stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True,
                              timeout=COPY_TIMEOUT_SECONDS)
    except subprocess.TimeoutExpired:
        return False, "the copy took longer than %d s" % COPY_TIMEOUT_SECONDS
    except OSError as e:
        return False, printable(str(e) or type(e).__name__)
    if done.returncode == 0:
        return True, ""
    return False, failure_reason(done.stderr, done.returncode)


def stale_downloads(entries, now):
    return [name for name, mtime in entries
            if name.startswith("logs-") and name.endswith(".tgz") and now - mtime > STALE_DOWNLOAD_SECONDS]


def remove_stale_downloads(parent):
    entries = []
    with contextlib.suppress(OSError):
        with os.scandir(parent) as listing:
            for entry in listing:
                if entry.is_file(follow_symlinks=False):
                    entries.append((entry.name, entry.stat(follow_symlinks=False).st_mtime))
    for name in stale_downloads(entries, time.time()):
        remove_quietly(os.path.join(parent, name))


def bring_logs_back(run_dir, uid):
    if not SANDBOX:
        return
    parent = os.path.dirname(run_dir)
    if not prepare_logs_parent(parent, uid):
        say("not copying the TLC logs back: %s is not a private folder of yours" % parent)
        return
    remove_stale_downloads(parent)
    try:
        fd, tgz = tempfile.mkstemp(prefix="logs-", suffix=".tgz", dir=parent)
        os.close(fd)
    except OSError as e:
        say("could not copy the TLC logs back: %s" % e)
        return
    try:
        ok, reason = fetch_logs(run_dir, tgz)
        if not ok:
            say("could not copy the TLC logs back from the sandbox: %s; get them with: fx-cloud pull %s ." % (
                reason, shell_quote_printable(run_dir + ".tgz")))
            return
        count, skipped, refused, error = extract_logs(tgz, run_dir)
    finally:
        remove_quietly(tgz)
    if error:
        say("could not unpack the TLC logs: %s" % error)
    for note in log_notes(count, skipped, refused, run_dir):
        say(note)


def cmd_tla(args):
    """The sh, bash and python3 shims call this only for a call that looks like a TLA+ runner."""
    flags, rest = take_flags(args, (), valued=("--real", "--tool"))
    tool, real = flags.get("--tool", ""), flags.get("--real")
    if tool not in TLA_OPTS or not real or not os.access(real, os.X_OK):
        die("the shim found no real %s; set FXC_LOCAL=1 or check PATH" % (tool or "program"), 127)
    route = tla_route(tool, rest)
    if route != "local" and not project_allows_remote(os.getcwd()):
        route = "local"
    if os.environ.get("FXC_SHIM_DRYRUN"):
        print("%s %s -> %s" % (tool, shlex.join(rest), route))
        return 0
    if route == "local":
        os.execv(real, [real] + rest)  # the absolute path, so Python finds its own prefix
    say("%s runs in this agent's sandbox: TLC runs there, not on this Mac" % shlex.join([tool] + rest[:2]))
    uid = os.getuid()
    run_dir = run_dir_path(uid, uuid.uuid4().hex[:RUN_ID_CHARS])
    pack_command = helper_script("packlogs", run_dir, run_dir + ".tgz")
    rc, _, ran = run_here_and_ran(remote_script(shlex.join([tool] + rest), run_dir, pack_command))
    if not ran:
        # The sandbox did not start the check and already said why, so no logs exist.
        return rc
    # The run's exit code must stay the check's own, so a broken copy-back only prints a note.
    try:
        bring_logs_back(run_dir, uid)
    except Exception as e:
        say("could not copy the TLC logs back: %s" % printable(str(e) or type(e).__name__))
    return rc


def shim_args(args):
    flags, rest = take_flags(args, (), valued=("--real",))
    real = flags.get("--real")
    if not real or not os.access(real, os.X_OK):
        die("the shim found no real binary; set FXC_LOCAL=1 or check PATH", 127)
    return real, rest


def shim_exec_local(real, tool, args):
    os.execv(real, [tool] + list(args))


def cmd_zig(args):
    real, rest = shim_args(args)
    route = zig_route(rest)
    if route != "local" and not project_allows_remote(os.getcwd()):
        route = "local"
    if os.environ.get("FXC_SHIM_DRYRUN"):
        print("zig %s -> %s" % (shlex.join(rest), route))
        return 0
    if route == "local":
        shim_exec_local(real, "zig", rest)
    if route == "remote-run":
        rc, _ = run_here(shlex.join(["zig"] + rest), {})
        return rc
    # remote-install: a local `zig build` leaves a binary for this Mac in the prefix, so the sandbox
    # builds for macOS (unless a target is given) and the result is copied back to the same prefix.
    build = rest[1:]
    steps, prefix, target = zig_build_parts(build)
    prefix = prefix or "zig-out"
    out = build_out(target or mac_target())
    keep = []
    i = 0
    while i < len(build):  # the user's prefix is where the copy goes; the build uses OUT
        if build[i] in ("-p", "--prefix"):
            i += 2
            continue
        if not build[i].startswith("--prefix="):
            keep.append(build[i])
        i += 1
    if not target:
        keep = ["-Dtarget=%s" % mac_target()] + keep
    say("zig build runs in this agent's sandbox%s; the result comes back to %s"
        % ("" if target else " for macOS", prefix))
    rc, _ = run_here(shlex.join(["zig", "build", "--prefix", out] + keep), {})
    if rc != 0:
        return rc
    rc, results, _ = helper_call("tar", os.path.realpath(os.getcwd()), out)
    last = results[-1] if results else {}
    if rc != 0:
        die("sandbox: %s" % last.get("error", "exit %d" % rc))
    with tempfile.TemporaryDirectory() as tmp:
        tgz = os.path.join(tmp, "out.tgz")
        if subprocess.call(vercel("copy", "%s:%s" % (SANDBOX, last["tarball"]), tgz),
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) != 0:
            die("could not copy the build back from the sandbox")
        staging = os.path.join(tmp, "x")
        os.makedirs(staging)
        extract_plain(tgz, staging)
        src = os.path.join(staging, os.path.basename(out))
        dest = os.path.join(os.getcwd(), prefix) if not os.path.isabs(prefix) else prefix
        count = 0
        for dirpath, _dirs, files in os.walk(src):
            for name in files:
                rel = os.path.relpath(os.path.join(dirpath, name), src)
                os.makedirs(os.path.dirname(os.path.join(dest, rel)), exist_ok=True)
                shutil.copy2(os.path.join(dirpath, name), os.path.join(dest, rel))
                count += 1
    # OUT stays in the sandbox: the next build of the same target installs only what changed.
    say("copied %d %s to %s" % (count, "file" if count == 1 else "files", dest))
    return 0


def cmd_bun(args):
    real, rest = shim_args(args)
    route = bun_route(rest)
    if route != "local" and not project_allows_remote(os.getcwd()):
        route = "local"
    if os.environ.get("FXC_SHIM_DRYRUN"):
        print("bun %s -> %s" % (shlex.join(rest), route))
        return 0
    if route == "local":
        shim_exec_local(real, "bun", rest)
    # In the sandbox: build the project's Linux binary first when it is a Zig project, because
    # E2E tests and drivers run it; install the nearest package.json's dependencies when missing.
    script = (
        'top=$(git rev-parse --show-toplevel 2>/dev/null || pwd); '
        'if [ -f "$top/build.zig" ]; then (cd "$top" && zig build) || exit $?; fi; '
        'd=$PWD; while [ "$d" != / ] && [ ! -f "$d/package.json" ]; do d=$(dirname "$d"); done; '
        'if [ -f "$d/package.json" ] && [ ! -d "$d/node_modules" ]; then '
        '(cd "$d" && (bun install --frozen-lockfile >/dev/null 2>&1 || bun install >/dev/null)) || exit $?; fi; '
        'exec ' + shlex.join(["bun"] + rest))
    rc, _ = run_here(script, {})
    return rc


def extract_plain(tgz, dest):
    """Extracts regular files and folders only, and refuses paths that leave DEST."""
    root = os.path.realpath(dest)
    count = 0
    with tarfile.open(tgz, "r:gz") as tar:
        for m in tar.getmembers():
            target = os.path.realpath(os.path.join(root, m.name))
            if not (target == root or target.startswith(root + os.sep)):
                die("refusing unexpected path in the tarball: %r" % m.name)
            if m.isdir():
                os.makedirs(target, exist_ok=True)
            elif m.isreg():
                os.makedirs(os.path.dirname(target), exist_ok=True)
                with tar.extractfile(m) as src, open(target, "wb") as out:
                    shutil.copyfileobj(src, out)
                os.chmod(target, m.mode & 0o755 | 0o600)
                count += 1
    return count


