def add_tree(tar, root, arc_prefix=""):
    """Adds a skills folder, following symlinks and skipping broken ones and build clutter."""
    for dirpath, dirnames, filenames in os.walk(root, followlinks=True):
        dirnames[:] = [d for d in dirnames if d not in SKILL_SKIP]
        for name in filenames:
            if name in SKILL_SKIP:
                continue
            path = os.path.join(dirpath, name)
            if not os.path.exists(path):
                continue
            arc = os.path.join(arc_prefix, os.path.relpath(path, root))
            info = tar.gettarinfo(os.path.realpath(path), arcname=arc)
            if info is None or not info.isreg():
                continue
            info.uid = info.gid = 0
            info.uname = info.gname = ""
            with open(path, "rb") as f:
                tar.addfile(info, f)


def strip_section(text, heading):
    """Removes one `## ` section, so the sandbox copy of the global rules skips the Mac-only rule."""
    start = text.find(heading)
    if start < 0:
        return text
    end = text.find("\n## ", start + len(heading))
    return text[:start].rstrip("\n") + ("\n\n" + text[end + 1:] if end >= 0 else "\n")


def build_bundle(tmp):
    b = os.path.join(tmp, "fxc")
    shutil.copytree(os.path.join(HERE, "remote"), os.path.join(b, "remote"))
    mac = os.path.join(b, "mac")
    os.makedirs(mac)
    shutil.copy(os.path.join(MAC_WS, "AGENTS.md"), os.path.join(mac, "workspace-AGENTS.md"))
    with open(os.path.join(HOME, ".fx", "AGENTS.md")) as f:
        global_rules = f.read()
    with open(os.path.join(mac, "global-AGENTS.md"), "w") as f:
        f.write(strip_section(global_rules, GLOBAL_RULE_HEADING))
    shutil.copy(os.path.join(HOME, ".local", "bin", "aig"), os.path.join(mac, "aig"))
    if os.path.exists(os.path.join(MAC_WS, ".fx.json")):
        shutil.copy(os.path.join(MAC_WS, ".fx.json"), os.path.join(mac, "fx.json"))
    with open(os.path.join(HOME, ".fx", "settings.json")) as f:
        settings = json.load(f)
    with open(os.path.join(mac, "settings.json"), "w") as f:
        json.dump({k: settings[k] for k in SETTINGS_KEYS if k in settings}, f, indent=2)
    skills = os.path.join(b, "skills")
    os.makedirs(skills)
    for root in SKILL_ROOTS:
        src = os.path.join(HOME, "." + root, "skills")
        if os.path.isdir(src):
            with tarfile.open(os.path.join(skills, root + ".tgz"), "w:gz") as tar:
                add_tree(tar, src)
    bundle = os.path.join(tmp, "fxc-bundle.tgz")
    with tarfile.open(bundle, "w:gz") as tar:
        tar.add(b, arcname="fxc")
    return bundle


def cmd_setup(args):
    if not LEGACY:
        return cmd_base(args)
    warm = "--no-warm" not in args
    if not sandbox_exists():
        say("creating sandbox %s in %s/%s" % (SANDBOX, TEAM, PROJECT))
