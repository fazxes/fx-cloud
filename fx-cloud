def say(msg):
    print("fx-cloud: " + msg, file=sys.stderr)


def die(msg, code=1):
    say(msg)
    sys.exit(code)


def short(path):
    """PATH with the home folder written as ~."""
    if path == HOME or path.startswith(HOME + os.sep):
        return "~" + path[len(HOME):]
    return path


def write_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = "%s.%d.tmp" % (path, os.getpid())
    with open(tmp, "w") as f:
        json.dump(data, f, indent=1)
        f.write("\n")
    os.replace(tmp, path)


# --------------------------------------------------------------------------- settings

class ConfigError(Exception):
    pass


def not_set_up():
    return "fx-cloud is not set up yet: run `fx-cloud init` (there is no %s)" % short(CONFIG_FILE)


def as_int(key, value, low):
    if isinstance(value, bool):
        raise ConfigError("%s must be a whole number" % key)
    try:
        n = int(str(value).strip())
    except ValueError:
        raise ConfigError("%s must be a whole number, not %r" % (key, value)) from None
    if n < low:
        raise ConfigError("%s must be at least %d" % (key, low))
    return n


def str_list(key, value, allow_empty=True):
    if not isinstance(value, list) or not all(isinstance(v, str) and v.strip() for v in value):
        raise ConfigError("%s must be a list of strings" % key)
    if not value and not allow_empty:
        raise ConfigError("%s must not be empty" % key)
    return [v.strip() for v in value]


def check_config(raw, required=True):
    """The settings in RAW on top of the defaults, checked and normalized. REQUIRED needs a team
    and a project."""
    cfg = dict(DEFAULTS)
    cfg.update(raw)
    for key in ("team", "project"):
        v = cfg[key]
        if v is not None and not isinstance(v, str):
            raise ConfigError("%s must be a string" % key)
        cfg[key] = (v or "").strip() or None
        if required and not cfg[key]:
            raise ConfigError("%s is not set; run `fx-cloud init`" % key)
    if not isinstance(cfg["prefix"], str) or not PREFIX_RE.match(cfg["prefix"]):
        raise ConfigError("prefix must be 1 to 16 lowercase letters, digits or dashes that start with "
                          "a letter, such as fxc-")
    cfg["vcpus"] = as_int("vcpus", cfg["vcpus"], 1)
    cfg["idle_minutes"] = as_int("idle_minutes", cfg["idle_minutes"], 5)
    cfg["max_agents"] = as_int("max_agents", cfg["max_agents"], 1)
    cfg["local_only"] = str_list("local_only", cfg["local_only"])
    if isinstance(cfg["agent_command"], str):
        cfg["agent_command"] = shlex.split(cfg["agent_command"])
    cfg["agent_command"] = str_list("agent_command", cfg["agent_command"], allow_empty=False)
    if not isinstance(cfg["warm"], list):
        raise ConfigError('warm must be a list of {"repo": "<git url>", "run": ["<command>", ...]}')
    warm = []
    for i, w in enumerate(cfg["warm"]):
        if not isinstance(w, dict) or not isinstance(w.get("repo"), str) or not w["repo"].strip():
            raise ConfigError('warm[%d] needs a "repo" git URL' % i)
        warm.append({"repo": w["repo"].strip(), "run": str_list("warm[%d].run" % i, w.get("run", []))})
    cfg["warm"] = warm
    if not isinstance(cfg["copy_skills"], bool):
        raise ConfigError("copy_skills must be true or false")
    hook = cfg["setup_hook"]
    if hook is not None and not isinstance(hook, str):
        raise ConfigError("setup_hook must be the path of a script, or null")
    cfg["setup_hook"] = os.path.abspath(os.path.expanduser(hook.strip())) if hook and hook.strip() else None
    return cfg


def load_config(required=True):
    """(settings, found): config.json with the FXC_* environment variables on top. Without a
    config file, REQUIRED raises ConfigError that points to `fx-cloud init`."""
    try:
        with open(CONFIG_FILE) as f:
            raw = json.load(f)
        found = True
    except FileNotFoundError:
        if required:
            raise ConfigError(not_set_up()) from None
        raw, found = {}, False
    except (OSError, ValueError) as e:
        raise ConfigError("cannot read %s: %s" % (short(CONFIG_FILE), e)) from None
    if not isinstance(raw, dict):
        raise ConfigError("%s must hold a JSON object" % short(CONFIG_FILE))
    unknown = sorted(set(raw) - set(DEFAULTS))
    if unknown:
        say("note: %s has settings that fx-cloud does not know: %s" % (short(CONFIG_FILE), ", ".join(unknown)))
    raw = {k: v for k, v in raw.items() if k in DEFAULTS}
    for var, key in ENV_KEYS.items():
        if os.environ.get(var, "").strip():
            raw[key] = os.environ[var].strip()
    try:
        return check_config(raw, required=required), found
    except ConfigError as e:
        raise ConfigError("%s (in %s or its FXC_ variables)" % (e, short(CONFIG_FILE))) from None


def setup_config(required=True):
    global CFG, CONFIG_FOUND
    try:
        CFG, CONFIG_FOUND = load_config(required)
    except ConfigError as e:
        die(str(e))


def need_config(tool=None):
    """Stops a shim's remote route with a clear message when fx-cloud is not set up."""
    hint = ", or set FXC_LOCAL=1 to run %s here" % tool if tool else ""
    if not CONFIG_FOUND:
        die(not_set_up() + hint)
    if not (CFG.get("team") and CFG.get("project")):
        die("%s has no team or project; run `fx-cloud init`%s" % (short(CONFIG_FILE), hint))
    if shutil.which("vercel") is None:
        die("the Vercel CLI is missing; install it with `npm i -g vercel`%s" % hint)


def vercel(sub, *args):
    subs = [sub] if isinstance(sub, str) else list(sub)
    return ["vercel", "sandbox"] + subs + ["--scope", CFG["team"], "--project", CFG["project"]] + list(args)


def remote_cmd(script, interactive=False, env=None):
    flags = (["-i"] if interactive else []) + (env or [])
    return vercel("exec", *flags, SANDBOX, "--", "bash", "-lc", script)


def interactive(script, extra_env=None):
    """Runs a script on a terminal in the sandbox. Ctrl-C belongs to the remote program, not to us."""
    env = TERM_ENV + (extra_env or [])
    previous = signal.signal(signal.SIGINT, signal.SIG_IGN)
    try:
        child = subprocess.Popen(remote_cmd(script, interactive=True, env=env),
                                 preexec_fn=lambda: signal.signal(signal.SIGINT, signal.SIG_DFL))
        return child.wait()
    finally:
        signal.signal(signal.SIGINT, previous)


# --------------------------------------------------------------------------- agent sandboxes

def ps_table():
    """pid -> (parent pid, start time, command line) for every process on the Mac."""
    out = subprocess.run(["ps", "-A", "-o", "pid=,ppid=,lstart=,command="], capture_output=True,
                         text=True).stdout
    procs = {}
    for line in out.splitlines():
        m = re.match(r"\s*(\d+)\s+(\d+)\s+(\w{3}\s+\w{3}\s+\d+\s+[\d:]{8}\s+\d{4})\s+(.*)", line)
        if m:
            procs[int(m.group(1))] = (int(m.group(2)), " ".join(m.group(3).split()), m.group(4))
    return procs


def agent_program(cmd):
    """fx, claude or codex when command line CMD is that agent (also when Node runs it), else None.
    fx's own command helpers do not count."""
    words = cmd.split()
    if not words or "__fx_foreground_session__" in cmd:
        return None
    names = [os.path.basename(words[0])]
    if names[0] in ("node", "bun") and len(words) > 1:
        names.append(os.path.basename(words[1]))
    for name in names:
        name = re.sub(r"\.[cm]?js$", "", name)
        if name in AGENT_PROGRAMS:
            return name
    return None


def find_owner(procs=None, start_pid=None):
    """The agent process that runs this command: the nearest fx, claude or codex above us. fx keeps
    its PID and start time when it restarts itself for an update."""
    procs = ps_table() if procs is None else procs
    pid, hops = (os.getppid() if start_pid is None else start_pid), 0
    while pid > 1 and pid in procs and hops < 64:
        ppid, start, cmd = procs[pid]
        prog = agent_program(cmd)
        if prog:
            return {"pid": pid, "start": start, "cmd": cmd[:160], "prog": prog}
        pid, hops = ppid, hops + 1
    return None


def current_owner():
    """(owner id, owner process or None). FXC_OWNER wins. Without an agent above us the owner is the
    shell; then only the idle timeout and `fx-cloud done` end its sandboxes."""
    named = os.environ.get("FXC_OWNER", "").strip()
    if named:
        return "named:" + named, None
    owner = find_owner()
    if owner:
        return "%s:%d@%s" % (owner["prog"], owner["pid"], owner["start"]), owner
    return "shell", None


def folder_root(path):
    """The folder a sandbox belongs to: the git worktree around PATH, else PATH itself."""
    p = subprocess.run(["git", "-C", path, "rev-parse", "--show-toplevel"], capture_output=True)
    top = p.stdout.decode().strip()
    return os.path.realpath(top if p.returncode == 0 and top else path)


def agent_name(owner_id, root):
    key = "\0".join((CFG["team"] or "", CFG["project"] or "", owner_id, root))
    return CFG["prefix"] + hashlib.sha1(key.encode()).hexdigest()[:12]


def is_agent_name(name):
    """True for the agent sandboxes of this prefix: the prefix and 12 hex digits. Base and probe
    sandboxes, and every other name, never match."""
    prefix = CFG["prefix"]
    return name.startswith(prefix) and re.fullmatch(r"[0-9a-f]{12}", name[len(prefix):]) is not None


def is_base_name(name):
    return name.startswith(CFG["prefix"] + "base-")


def entry_path(name):
    return os.path.join(AGENTS_DIR, name + ".json")


def read_entry(name):
    try:
        with open(entry_path(name)) as f:
            e = json.load(f)
    except (OSError, ValueError):
        return None
    if not isinstance(e, dict) or e.get("name") != name or not is_agent_name(name) \
            or e.get("team") != CFG["team"] or e.get("project") != CFG["project"]:
        return None
    return e


def write_entry(entry):
    write_json(entry_path(entry["name"]), entry)


def all_entries():
    """This Mac's agent sandboxes for the configured team, project and prefix."""
    names = sorted(n[:-5] for n in os.listdir(AGENTS_DIR) if n.endswith(".json")) \
        if os.path.isdir(AGENTS_DIR) else []
    return [e for e in (read_entry(n) for n in names if is_agent_name(n)) if e]


@contextlib.contextmanager
def file_lock(path, wait=True):
    """An exclusive lock on PATH. Without WAIT, yields False when another process holds it."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "a") as f:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | (0 if wait else fcntl.LOCK_NB))
        except OSError:
            yield False
            return
        try:
            yield True
        finally:
            fcntl.flock(f, fcntl.LOCK_UN)


def read_base():
    """The base snapshot of the configured team, project and prefix, or None."""
    try:
        with open(BASE_FILE) as f:
            base = json.load(f)
    except (OSError, ValueError):
        return None
    if not isinstance(base, dict) or not base.get("snapshot") or (
            base.get("team"), base.get("project"), base.get("prefix")) != (
            CFG["team"], CFG["project"], CFG["prefix"]):
        return None
    return base


def ago(ts):
    s = max(0, int(time.time() - (ts or 0)))
    if s < 3600:
        return "%dm" % (s // 60)
    if s < 86400:
        return "%dh%02dm" % (s // 3600, s % 3600 // 60)
    return "%dd" % (s // 86400)


def set_agent_clock(idle_min):
    """The session clock of an agent sandbox, from the idle time it was made with."""
    global SESSION_TIMEOUT_S, EXTEND_WHEN_LEFT_S, EXTEND_BY, EXTEND_BY_S
    SESSION_TIMEOUT_S = idle_min * 60
    EXTEND_WHEN_LEFT_S = idle_min * 40  # two thirds of the idle time, in seconds
    EXTEND_BY, EXTEND_BY_S = "%dm" % idle_min, idle_min * 60


def drop_local_state(name):
    """Forgets what this Mac knows about sandbox NAME: its entry, its copy caches, its clock."""
    for path in (entry_path(name), os.path.join(STATE_DIR, "extend", name + ".json")):
        try:
            os.unlink(path)
        except OSError:
            pass
    for d in (os.path.join(PUSH_CACHE, name), os.path.join(PLAIN_CACHE, name)):
        shutil.rmtree(d, ignore_errors=True)


def create_agent_sandbox(name, owner_id, owner, root, base):
    live = [e for e in all_entries() if e["name"] != name]
    if len(live) >= CFG["max_agents"]:
        # Its lines go to gc.log, as from the background gc: this output is the agent's command output.
        os.makedirs(STATE_DIR, exist_ok=True)
        log_path = os.path.join(STATE_DIR, "gc.log")
        with open(log_path, "a") as log, contextlib.redirect_stdout(log):
            doomed, failed = run_gc(quiet=True)
        say("%d agent sandboxes is the limit; removed %d that no agent needs (%s)"
            % (CFG["max_agents"], len(doomed) - len(failed), short(log_path)))
        live = [e for e in all_entries() if e["name"] != name]
        if len(live) >= CFG["max_agents"]:
            say("note: %d agent sandboxes are open (max_agents is %d); `fx-cloud ls` lists them"
                % (len(live), CFG["max_agents"]))
    say("starting this agent's sandbox for %s (%s, %d vCPUs, from the base snapshot)"
        % (short(root), name, CFG["vcpus"]))
    t0 = time.time()
    # A create can fail for a short time, for example with 403 Not authorized for about a minute
    # after a new base snapshot, so it gets two more tries.
    for wait in (5, 15, None):
        p = subprocess.run(vercel("create", "--name", name, "--snapshot", base["snapshot"], "--non-persistent",
                                  "--vcpus", str(CFG["vcpus"]), "--timeout", "%dm" % CFG["idle_minutes"],
                                  "--tag", "fxc=agent", "--silent"), capture_output=True, text=True)
        if p.returncode == 0 or "already" in (p.stdout + p.stderr).lower():
            break
        if wait is None:
            sys.stderr.write((p.stdout + p.stderr)[-2000:])
            die("could not start a sandbox for this agent")
        lines = (p.stdout + p.stderr).strip().splitlines() or ["exit %d" % p.returncode]
        why = next((l for l in lines if "rror" in l), lines[-1]).strip()
        say("starting the sandbox failed (%s); trying again in %d s" % (why[:120], wait))
        time.sleep(wait)
    now = time.time()
    write_entry({"name": name, "team": CFG["team"], "project": CFG["project"], "owner": owner_id,
                 "owner_pid": owner["pid"] if owner else None, "owner_start": owner["start"] if owner else None,
                 "owner_prog": owner["prog"] if owner else "", "owner_cmd": owner["cmd"] if owner else "",
                 "root": root, "created": now, "used": now, "snapshot": base["snapshot"],
                 "idle_min": CFG["idle_minutes"]})
    say("the sandbox is ready after %.0f s" % (now - t0))
    days = (now - base.get("created", now)) / 86400
    if days > BASE_STALE_DAYS:
        say("note: the base snapshot is %.0f days old; `fx-cloud base` makes a new one" % days)


def use_sandbox(root, create=True):
    """Points this command at its agent's sandbox for ROOT, and starts that sandbox when needed.
    Returns the sandbox's entry, or None when CREATE is false and none exists."""
    global SANDBOX
    owner_id, owner = current_owner()
    name = agent_name(owner_id, root)
    SANDBOX = name
    entry = read_entry(name)
    if entry is None:
        if not create:
            return None
        base = read_base()
        if not base:
            die("there is no base snapshot for %s/%s yet; run `fx-cloud base` (about a minute, more with warm builds)"
                % (CFG["team"], CFG["project"]))
        with file_lock(os.path.join(AGENTS_DIR, name + ".lock")):
            entry = read_entry(name)  # a parallel command of the same agent may have started it
            if entry is None:
                create_agent_sandbox(name, owner_id, owner, root, base)
                entry = read_entry(name)
    elif time.time() - entry.get("used", 0) > 60:
        entry["used"] = time.time()
        write_entry(entry)
    set_agent_clock(entry.get("idle_min", CFG["idle_minutes"]))
    maybe_background_gc()
    return entry


def restart_sandbox():
    """This command's sandbox is gone, for example removed by gc: start a new one for it."""
    entry = read_entry(SANDBOX)
    root = entry["root"] if entry else folder_root(os.getcwd())
    drop_local_state(SANDBOX)
    say("this agent's sandbox is gone; starting a new one")
    use_sandbox(root)


def detach(argv, log):
    """Starts ARGV fully detached (double fork, new session), so it outlives this command."""
    pid = os.fork()
    if pid:
        os.waitpid(pid, 0)
        return
    try:
        os.setsid()
        if os.fork():
            os._exit(0)
        out = os.open(log, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        null = os.open(os.devnull, os.O_RDONLY)
        os.dup2(null, 0)
        os.dup2(out, 1)
        os.dup2(out, 2)
        os.closerange(3, 4096)
        os.execv(argv[0], argv)
    finally:
        os._exit(1)


def maybe_background_gc():
    """At most every GC_EVERY_S, starts `fx-cloud gc --quiet` in the background."""
    stamp = os.path.join(STATE_DIR, "gc.stamp")
    try:
        if time.time() - os.path.getmtime(stamp) < GC_EVERY_S:
            return
    except OSError:
        pass
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(stamp, "w"):
        pass
    detach([sys.executable, os.path.realpath(__file__), "gc", "--quiet"], os.path.join(STATE_DIR, "gc.log"))


def parse_sandbox_rows(text):
    """(name, status, snapshot) for each row of `vercel sandbox list`."""
    rows = []
    for line in text.splitlines():
        w = line.split()
        if len(w) >= 2 and re.fullmatch(r"[a-z0-9][a-z0-9-]*", w[0]):
            m = re.search(r"\bsnap_[A-Za-z0-9]+", line)
            rows.append((w[0], w[1], m.group(0) if m else None))
    return rows


def list_sandboxes(prefix):
    """(name, status, snapshot) of every sandbox whose name starts with PREFIX, or None when the
    list fails. The API returns at most 50 per page and prints a --cursor hint when there are more."""
    rows, cursor = [], None
    for _ in range(40):
        p = subprocess.run(vercel("list", "--all", "--name-prefix", prefix, "--limit", "50",
                                  *(["--cursor", cursor] if cursor else [])), capture_output=True, text=True)
        if p.returncode != 0:
            return None
        rows += [r for r in parse_sandbox_rows(p.stdout) if r[0].startswith(prefix)]
        m = re.search(r"--cursor[= ]+['\"]?([A-Za-z0-9_\-=.]+)", p.stdout + p.stderr)
        if not m or m.group(1) == cursor:
            break
        cursor = m.group(1)
    return rows


def list_agents():
    """name -> (status, snapshot) of the agent sandboxes of this prefix, or None when the list fails."""
    rows = list_sandboxes(CFG["prefix"])
    return None if rows is None else {n: (s, snap) for n, s, snap in rows if is_agent_name(n)}


def list_remote():
    """name -> status of the agent sandboxes of this prefix, or None when the list fails."""
    agents = list_agents()
    return None if agents is None else {n: s for n, (s, _) in agents.items()}


def remove_sandboxes(names):
    """Removes agent sandboxes and forgets them on this Mac. Returns the names it could not remove.
    Names that are not agent sandboxes of this prefix are never removed."""
    names = sorted(n for n in set(names) if is_agent_name(n))
    if not names:
        return []
    failed = []
    if subprocess.run(vercel("rm", "--delete-orphan-snapshots", *names), capture_output=True).returncode != 0:
        for n in names:  # one bad name fails the whole call, so try them one at a time
            q = subprocess.run(vercel("rm", "--delete-orphan-snapshots", n), capture_output=True, text=True)
            if q.returncode != 0 and "not found" not in (q.stdout + q.stderr):
                failed.append(n)
    for n in names:
        if n not in failed:
            drop_local_state(n)
    return failed


def owner_alive(entry, procs):
    pid = entry.get("owner_pid")
    if not pid:
        return True  # a named or shell owner: the idle timeout and `fx-cloud done` end it
    p = procs.get(pid)
    return bool(p and p[1] == entry.get("owner_start"))


STOPPED = ("stopped", "failed", "aborted", "error")


def gc_plan(entries, remote, procs, everything=False):
    """(doomed: name -> reason, forget: entries to drop locally). REMOTE is name -> status, or
    None when the list failed."""
    doomed, forget = {}, []
    for e in entries:
        n = e["name"]
        if remote is not None and n not in remote and time.time() - e.get("created", 0) > 300:
            forget.append(n)  # already removed elsewhere
        elif everything:
            doomed[n] = "asked"
        elif not owner_alive(e, procs):
            doomed[n] = "its %s process ended" % (e.get("owner_prog") or "agent")
        elif not os.path.isdir(e["root"]):
            doomed[n] = "its folder is gone"
        elif remote and remote.get(n) in STOPPED:
            doomed[n] = "it stopped after %d idle minutes" % e.get("idle_min", CFG["idle_minutes"])
    known = {e["name"] for e in entries}
    for n, status in (remote or {}).items():
        if is_agent_name(n) and n not in known and (everything or status in STOPPED):
            doomed[n] = "no agent on this Mac uses it"
    return doomed, forget


def run_gc(everything=False, quiet=False, dry_run=False):
    """Removes the agent sandboxes that no agent needs: the agent process that owns one ended, its
    folder is gone, or it stopped after being idle. EVERYTHING removes every agent sandbox."""
    procs, entries, agents = ps_table(), all_entries(), list_agents()
    remote = None if agents is None else {n: s for n, (s, _) in agents.items()}
    doomed, forget = gc_plan(entries, remote, procs, everything)
    stamp = time.strftime("%Y-%m-%d %H:%M:%S")
    if dry_run:
        for n, why in sorted(doomed.items()):
            print("would remove %s: %s" % (n, why))
        if not doomed:
            print("nothing to remove")
        return doomed, []
    for n in forget:
        drop_local_state(n)
    failed = remove_sandboxes(list(doomed))
    for n, why in sorted(doomed.items()):
        print("%s %s %s: %s" % (stamp, "could not remove" if n in failed else "removed", n, why))
    if agents is not None:
        clean_old_bases({n: v for n, v in agents.items() if n not in doomed or n in failed}, quiet)
    if quiet:
        print("%s gc: %d agent sandboxes known, %d running, %d removed" % (
            stamp, len(entries), sum(1 for s in (remote or {}).values() if s == "running"),
            len(doomed) - len(failed)))
    elif not doomed:
        print("nothing to remove")
    return doomed, failed


def cmd_gc(args):
    flags, rest = take_flags(args, ("--all", "--quiet", "--dry-run"))
    if rest:
        die("usage: fx-cloud gc [--all] [--dry-run]", 2)
    log = os.path.join(STATE_DIR, "gc.log")
    if flags.get("--quiet") and os.path.exists(log) and os.path.getsize(log) > 1 << 20:
        os.replace(log, log + ".old")
    with file_lock(os.path.join(STATE_DIR, "gc.lock"), wait=not flags.get("--quiet")) as held:
        if not held:
            return 0  # another gc runs now
        _, failed = run_gc(everything=bool(flags.get("--all")), quiet=bool(flags.get("--quiet")),
                           dry_run=bool(flags.get("--dry-run")))
    return 1 if failed else 0


def cmd_ls(_args):
    procs, entries, remote = ps_table(), all_entries(), list_remote() or {}
    known = {e["name"] for e in entries}
    if not entries and not remote:
        print("no agent sandboxes")
        return 0
    print("%-17s %-8s %-28s %-6s %-6s %s" % ("SANDBOX", "STATE", "AGENT", "AGE", "IDLE", "FOLDER"))
    for e in sorted(entries, key=lambda e: e.get("created", 0)):
        if e.get("owner_pid"):
            agent = "%s %d (%s)" % (e.get("owner_prog") or "agent", e["owner_pid"],
                                    "running" if owner_alive(e, procs) else "ended")
        else:
            agent = e.get("owner", "").replace("named:", "")
        print("%-17s %-8s %-28s %-6s %-6s %s" % (e["name"], remote.get(e["name"], "gone"), agent[:28],
                                                 ago(e.get("created")), ago(e.get("used")), short(e["root"])))
    for n, status in sorted(remote.items()):
        if n not in known:
            print("%-17s %-8s %-28s" % (n, status, "(not known on this Mac)"))
    return 0


def cmd_done(args):
    flags, rest = take_flags(args, ("--all",))
    if rest:
        die("usage: fx-cloud done [--all]", 2)
    owner_id, _ = current_owner()
    if flags.get("--all"):
        names = [e["name"] for e in all_entries() if e.get("owner") == owner_id]
    else:
        name = agent_name(owner_id, folder_root(os.getcwd()))
        names = [name] if read_entry(name) else []
    if not names:
        say("this agent has no sandbox%s" % ("" if flags.get("--all") else " for this folder"))
        return 0
    failed = remove_sandboxes(names)
    for n in names:
        say("%s %s" % ("could not remove" if n in failed else "removed", n))
    return 1 if failed else 0


