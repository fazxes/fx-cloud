def seed_facts(name):
    """(number of Zig cache seeds, the CPU model that Zig sees as native) in sandbox NAME."""
    p = subprocess.run(vercel("exec", name, "--", "bash", "-lc",
                              "echo FXC_SEEDS $(ls $HOME/.cache/fxc-zig-seed/*/meta.json 2>/dev/null | wc -l); "
                              "cd /tmp && zig build-exe --show-builtin 2>/dev/null | grep -m1 -o 'cpu\\.[a-z0-9_]*'"),
                       capture_output=True, text=True)
    seeds = re.search(r"FXC_SEEDS (\d+)", p.stdout)
    cpu = re.search(r"cpu\.([a-z0-9_]+)", p.stdout)
    return (int(seeds.group(1)) if seeds else 0), (cpu.group(1) if cpu else None)


def sandbox_cpu(name):
    return seed_facts(name)[1]


def add_cpu_seeds(name, base_cpu, t0, warm):
    """Adds the native build programs of the other CPU models in SEED_CPUS to the seeds of base
    sandbox NAME, and takes its snapshot again. Probe sandboxes from the new snapshot make them; a
    model that no probe lands on costs an agent there a few minutes on its first build. Any failure
    keeps the first snapshot as the base."""
    global SANDBOX
    want = [c for c in SEED_CPUS if c != base_cpu]
    if not want or not base_cpu:
        return
    snap = read_base()["snapshot"]
    stamp = time.strftime("%H%M%S")
    found, made, lock = {}, [], threading.Lock()

    def probe(i):
        n = "%sprobe-%s-%d" % (CFG["prefix"], stamp, i)
        if subprocess.call(vercel("create", "--name", n, "--snapshot", snap, "--non-persistent",
                                  "--vcpus", str(CFG["vcpus"]), "--timeout", "30m", "--tag", "fxc=probe",
                                  "--silent"),
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) != 0:
            return
        with lock:
            made.append(n)
        cpu = sandbox_cpu(n)
        with lock:
            if cpu in want and cpu not in found:
                found[cpu] = n

    def run_all(fn, items):
        threads = [threading.Thread(target=fn, args=(it,)) for it in items]
        for th in threads:
            th.start()
        for th in threads:
            th.join()

    results = {}

    def build(cpu):
        n = found[cpu]
        p = subprocess.run(vercel("exec", n, "--", "bash", "-lc", CPU_SEED_SCRIPT), capture_output=True, text=True)
        m = re.search(r"FXC_CPU_SEED (\d+) (\d+) (\d+) (\d+)", p.stdout)
        if p.returncode != 0 or not m:
            results[cpu] = "failed (exit %d): %s" % (p.returncode, (p.stdout + p.stderr).strip()[-300:])
            return
        for part in ("local", "global"):
            dest = os.path.join(tmp, "fxc-cpu-%s-%s.tgz" % (cpu, part))
            if subprocess.call(vercel("copy", "%s:/tmp/fxc-cpu-%s.tgz" % (n, part), dest),
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) != 0:
                results[cpu] = "failed: could not copy its %s files" % part
                return
        results[cpu] = (int(m.group(1)), int(m.group(2)), int(m.group(3)), int(m.group(4)))

    say("adding the Zig build programs for the CPU models %s to the seeds (the base has %s)"
        % (", ".join(want), base_cpu))
    with tempfile.TemporaryDirectory() as tmp:
        try:
            tried = 0
            while len(found) < len(want) and tried < MAX_PROBES:
                batch = min(4, MAX_PROBES - tried)
                run_all(probe, range(tried, tried + batch))
                tried += batch
            for n in made:  # the probes that no model needs
                if n not in found.values():
                    subprocess.run(vercel("rm", n), capture_output=True)
            missing = [c for c in want if c not in found]
            say("%d probe sandboxes; found %s%s" % (tried, ", ".join(sorted(found)) or "none",
                                                  "; not found: " + ", ".join(missing) if missing else ""))
            run_all(build, list(found))
        finally:
            for n in found.values():
                subprocess.run(vercel("rm", n), capture_output=True)
        good = []
        for cpu in sorted(results):
            r = results[cpu]
            if isinstance(r, tuple):
                good.append(cpu)
                say("  %s: built in %d s, %d local and %d global cache files, %d MB" % ((cpu,) + r))
            else:
                say("  %s: %s" % (cpu, r))
        if not good:
            say("no CPU model was added; the base stays as it is")
            return
        SANDBOX = name

        def give_up(why):
            subprocess.run(vercel("stop", name), capture_output=True)  # it resumed for the files
            say("%s; the base stays as it is" % why)

        if subprocess.run(remote_cmd("true"), capture_output=True).returncode != 0:
            return give_up("could not resume the base sandbox %s" % name)
        for cpu in good:
            for part in ("local", "global"):
                f = "fxc-cpu-%s-%s.tgz" % (cpu, part)
                if subprocess.call(vercel("copy", os.path.join(tmp, f), "%s:/tmp/%s" % (name, f)),
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) != 0:
                    return give_up("upload to the base sandbox failed")
    p = subprocess.run(remote_cmd(CPU_MERGE_SCRIPT % {"cpus": " ".join(shlex.quote(c) for c in good)}),
                       capture_output=True, text=True)
    m = re.search(r"FXC_SEED_CPUS (.*)", p.stdout)
    if p.returncode != 0 or not m:
        return give_up("adding the files failed (exit %d): %s"
                       % (p.returncode, (p.stdout + p.stderr).strip()[-300:]))
    say("the seeds now have the build programs for %s" % m.group(1))
    snapshot_base(name, t0, warm)


def describe_facts(facts):
    parts = ["zig %s" % facts["zig"] if facts["zig"] else "no zig",
             "bun %s" % facts["bun"] if facts["bun"] else "no bun"]
    parts.append("fx%s" % (" (%s)" % facts["fx_channel"] if facts["fx_channel"] else "") if facts["fx"] else "no fx")
    if facts["git_name"] or facts["git_email"]:
        parts.append("git identity %s <%s>" % (facts["git_name"], facts["git_email"]))
    return ", ".join(parts)


def base_create_flags():
    return ["--vcpus", str(CFG["vcpus"]), "--timeout", BASE_TIMEOUT,
            "--snapshot-expiration", "none", "--keep-last-snapshots", "2", "--keep-last-snapshots-for", "none"]


def cmd_base(args):
    """Builds a new base snapshot, which every new agent sandbox starts from. Each build uses a new
    sandbox, because a snapshot holds every disk block that a sandbox ever changed: a fresh one keeps
    it small, so agent sandboxes start in seconds. The build takes the sign-ins over from the old
    base (or from --from SANDBOX), installs everything with setup.sh, cleans up and warms the caches
    with base.sh, takes the snapshot, and then removes the old base sandbox."""
    global SANDBOX
    flags, rest = take_flags(args, ("--no-warm", "--no-cpu-seeds", "--remove"), valued=("--from",))
    if rest:
        die("usage: fx-cloud base [--no-warm] [--no-cpu-seeds] [--from SANDBOX] | fx-cloud base --remove", 2)
    if flags.get("--remove"):
        return remove_base()
    warm = not flags.get("--no-warm")
    if CFG["setup_hook"] and not os.path.isfile(CFG["setup_hook"]):
        die("setup_hook %s is not a file" % short(CFG["setup_hook"]))
    with file_lock(os.path.join(STATE_DIR, "base.lock"), wait=False) as held:
        if not held:
            say("a base build runs already")
            return 0
        old = read_base()
        src = flags.get("--from") or (old["sandbox"] if old else None)
        name = "%sbase-%s" % (CFG["prefix"], time.strftime("%Y%m%d-%H%M%S"))
        t0 = time.time()
        facts = mac_facts()
        say("the base gets %s" % describe_facts(facts))
        made = False
        try:
            with tempfile.TemporaryDirectory() as tmp:  # private to this user; removed with its files
                creds = take_credentials(src, tmp) if src and sandbox_named(src) else None
                say("sign-ins: %s" % ("taken over from %s" % src if creds else "none yet"))
                say("making the base sandbox %s in %s/%s" % (name, CFG["team"], CFG["project"]))
                SANDBOX = name
                if subprocess.call(vercel("create", "--name", name, *base_create_flags(), "--tag", "fxc=base"),
                                   stdout=subprocess.DEVNULL) != 0:
                    die("could not make the base sandbox")
                made = True
                bundle = build_bundle(tmp, facts)
                say("uploading the setup bundle (%.1f MB)" % (os.path.getsize(bundle) / 1e6))
                for local, remote in ((bundle, "/tmp/fxc-bundle.tgz"), (creds, "/tmp/fxc-creds.tgz")):
                    if local and subprocess.call(vercel("copy", local, "%s:%s" % (name, remote)),
                                                 stdout=subprocess.DEVNULL) != 0:
                        die("upload to the base sandbox failed")
            script = ("rm -rf /tmp/fxc && tar -xzf /tmp/fxc-bundle.tgz -C /tmp "
                      "&& { [ ! -f /tmp/fxc-creds.tgz ] || { (umask 077; cd ~ && tar -xzf /tmp/fxc-creds.tgz) "
                      "&& rm -f /tmp/fxc-creds.tgz; }; } "
                      "&& bash /tmp/fxc/remote/setup.sh /tmp/fxc "
                      "&& bash /tmp/fxc/remote/base.sh /tmp/fxc %s" % ("" if warm else "--no-warm"))
            rc = subprocess.call(remote_cmd(script))
            if rc != 0:
                die("the base build failed (exit %d); new agent sandboxes still use the old base" % rc)
            seeds, base_cpu = seed_facts(name) if warm and CFG["warm"] and facts["zig"] else (0, None)
            snapshot_base(name, t0, warm)
        except BaseException:
            if made:
                subprocess.run(vercel("rm", "--delete-orphan-snapshots", name), capture_output=True)
                say("removed the unfinished base sandbox %s" % name)
            raise
        if seeds and not flags.get("--no-cpu-seeds"):
            add_cpu_seeds(name, base_cpu, t0, warm)
    agents = list_agents()
    if agents is not None:
        clean_old_bases(agents)
    if not creds:
        say("optional: `fx-cloud login` signs the base in to GitHub (for private repositories) and fx")
    say("done: run `fx-cloud run <command>` from a project folder")
    return 0


def remove_base():
    """Removes the base sandbox and its snapshots. Agent sandboxes must be gone first."""
    base = read_base()
    if not base:
        say("there is no base for %s/%s" % (CFG["team"], CFG["project"]))
        return 0
    agents = list_agents()
    if agents is None:
        die("cannot list the sandboxes; check `vercel login`")
    if agents:
        die("%d agent sandboxes still exist; remove them first with `fx-cloud gc --all`" % len(agents))
    failed = False
    for n in [base["sandbox"]] + base.get("old_bases", []):
        if not is_base_name(n):
            continue
        p = subprocess.run(vercel("rm", "--delete-orphan-snapshots", n), capture_output=True, text=True)
        if p.returncode != 0 and "not found" not in (p.stdout + p.stderr).lower():
            failed = True
            say("could not remove the base sandbox %s: %s" % (n, (p.stdout + p.stderr).strip()[-300:]))
        else:
            say("removed the base sandbox %s" % n)
    for snap in dict.fromkeys(base.get("snapshots", []) + base.get("retired", []) + [base["snapshot"]]):
        if not delete_snapshot(snap):
            failed = True
            say("could not delete the snapshot %s" % snap)
    if failed:
        return 1
    os.unlink(BASE_FILE)
    say("the base is gone; `fx-cloud base` makes a new one")
    return 0


def cmd_login(_args):
    """Optional one-time sign-ins in the base sandbox. A new base snapshot keeps them for every
    agent sandbox."""
    global SANDBOX
    base = read_base()
    if not base:
        die("there is no base yet; run `fx-cloud base` first")
    SANDBOX = base["sandbox"]
    t0 = time.time()
    rc = interactive("bash ~/%s/login.sh" % SHARE_REL)
    say("saving the sign-ins in a new base snapshot")
    snapshot_base(SANDBOX, t0, base.get("warm", True))
    return rc


