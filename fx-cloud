def lgit(cwd, *args, env=None, check=True, data=None):
    p = subprocess.run(["git", "-C", cwd] + list(args), capture_output=True, env=env, input=data)
    if check and p.returncode != 0:
        die("git %s failed: %s" % (" ".join(args[:2]), p.stderr.decode(errors="replace").strip()[-600:]))
    return p


def lgit_out(cwd, *args, env=None):
    return lgit(cwd, *args, env=env).stdout.decode().strip()


def local_tree(top, gitdir, index, includes=()):
    """Tree id of the files as `git add -A` would stage them, plus the INCLUDES ignored files.
    The sandbox computes the same id."""
    tmp = os.path.join(gitdir, "fx-cloud-index.%d" % os.getpid())
    try:
        if os.path.exists(index):
            shutil.copy2(index, tmp)  # keeps its time, so git still re-reads racily clean files
        env = dict(os.environ, GIT_INDEX_FILE=tmp)
        lgit(top, "add", "-A", "--", ".", *TLC_PATHSPECS, env=env)
        if includes:
            lgit(top, "add", "-f", "--pathspec-from-file=-", "--pathspec-file-nul", env=env,
                 data="\0".join(includes).encode())
        return lgit_out(top, "write-tree", env=env)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def encode_list(items):
    if not items:
        return "-"
    arg = "b64:" + base64.b64encode("\0".join(items).encode()).decode()
    if len(arg) > INLINE_LIMIT:
        die("too many included files (%d); name fewer with --include or .fx-cloud-include" % len(items))
    return arg


def collect_includes(top, cwd, extra):
    """Ignored files to copy anyway: paths from .fx-cloud-include at the worktree top, one per line,
    and from --include, relative to the current folder."""
    specs = []
    listed = os.path.join(top, ".fx-cloud-include")
    if os.path.isfile(listed):
        with open(listed) as f:
            specs += [s.strip() for s in f if s.strip() and not s.strip().startswith("#")]
    for e in extra:
        rel = os.path.relpath(os.path.realpath(os.path.join(cwd, e)), top)
        if rel == ".." or rel.startswith(".." + os.sep):
            die("--include %s is outside the worktree %s" % (e, top))
        specs.append(rel)
    if not specs:
        return []
    out = lgit(top, "ls-files", "-z", "-o", "-i", "--exclude-standard", "--", *specs).stdout
    files = sorted(set(x.decode() for x in out.split(b"\0") if x))
    total = sum(os.path.getsize(os.path.join(top, f)) for f in files if os.path.isfile(os.path.join(top, f)))
    if len(files) > 5000 or total > PLAIN_LIMIT:
        die("the included ignored files are too large (%d files, %s); name fewer" % (len(files), human(total)))
    return files


def local_state(path, extra_includes=()):
    """The Mac worktree around PATH, or None outside git. Uses few git calls, because each one
    costs about 0.1 s on a busy Mac; the copy-only parts come later from copy_info()."""
    cwd = os.path.realpath(path)
    p = subprocess.run(["git", "-C", cwd, "rev-parse", "--show-toplevel", "--absolute-git-dir",
                        "--git-path", "index", "HEAD"], capture_output=True)
    lines = p.stdout.decode().splitlines()
    if p.returncode != 0:
        if len(lines) >= 2:  # a repository, but HEAD does not resolve
            die("%s has no commit yet; fx-cloud copies worktrees that have at least one commit" % lines[0])
        return None
    top, gitdir, index, sha = os.path.realpath(lines[0]), lines[1], lines[2], lines[3]
    if not os.path.isabs(index):
        index = os.path.join(cwd, index)
    includes = collect_includes(top, cwd, extra_includes)
    return {
        "top": top, "cwd": cwd, "sha": sha, "tree": local_tree(top, gitdir, index, includes),
        "key": hashlib.sha1(top.encode()).hexdigest()[:12],
        "includes": includes, "inc_arg": encode_list(includes),
    }


def copy_info(st):
    """Adds what a copy needs: the commit that carries the Mac's files, and the origin URL."""
    if "cwip" in st:
        return st
    env = dict(os.environ, **FIXED_IDENTITY)
    # A fixed identity and date make the same files give the same commit id. Nothing on the Mac
    # points to this commit.
    st["cwip"] = lgit_out(st["top"], "-c", "commit.gpgSign=false", "commit-tree", "--no-gpg-sign",
                          st["tree"], "-p", st["sha"], "-m", "fx-cloud copy", env=env)
    origin = lgit(st["top"], "config", "--get", "remote.origin.url", check=False)
    st["origin"] = origin.stdout.decode().strip() if origin.returncode == 0 else ""
    return st


