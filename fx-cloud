# The sign-ins that a new base takes over from the old one, relative to the sandbox home.
CRED_FILES = [".fx/auth.json", ".fx/settings.json", ".config/gh/hosts.yml", ".config/gh/config.yml",
              ".config/ai-gateway/project-fx.key", ".config/fx-cloud/team-chosen"]


def sandbox_named(name):
    p = subprocess.run(vercel("list", "--all", "--name-prefix", name), capture_output=True, text=True)
    return p.returncode == 0 and any(l.split()[:1] == [name] for l in p.stdout.splitlines())


def take_credentials(src, tmp):
    """Copies the sign-in files of sandbox SRC into TMP, a private folder. Returns the tarball."""
    global SANDBOX
    SANDBOX = src
    files = " ".join(shlex.quote(f) for f in CRED_FILES)
    p = subprocess.run(remote_cmd("cd ~ && ls -d %s 2>/dev/null | tar -czf /tmp/fxc-creds.tgz -T - && echo ok" % files),
                       capture_output=True, text=True)
    if p.returncode != 0 or "ok" not in p.stdout:
        return None
    tgz = os.path.join(tmp, "creds.tgz")
    rc = subprocess.call(vercel("copy", "%s:/tmp/fxc-creds.tgz" % src, tgz),
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(remote_cmd("rm -f /tmp/fxc-creds.tgz"), capture_output=True)
    return tgz if rc == 0 else None


def snapshot_base(name, t0, warm):
    """Snapshots the base sandbox NAME (this stops it) and makes the snapshot the new base."""
    say("taking the base snapshot; this stops the base sandbox")
    p = subprocess.run(vercel("snapshot", name, "--stop", "--expiration", "0"), capture_output=True, text=True)
    m = re.search(r"snap_[A-Za-z0-9]+", p.stdout + p.stderr)
    if p.returncode != 0 or not m:
        sys.stderr.write((p.stdout + p.stderr)[-2000:])
        die("the snapshot failed; new agent sandboxes still use the old base")
    os.makedirs(os.path.dirname(BASE_FILE), exist_ok=True)
    with open(BASE_FILE + ".tmp", "w") as f:
        json.dump({"snapshot": m.group(0), "created": time.time(), "sandbox": name, "warm": warm}, f, indent=1)
    os.replace(BASE_FILE + ".tmp", BASE_FILE)
    say("base snapshot %s is ready after %.0f s; new agent sandboxes start from it" % (m.group(0), time.time() - t0))


# The CPU models that agent sandboxes land on (11 probes in Nov 2026: cascadelake 5,
# skylake_avx512 4, icelake_server 2). Zig compiles fx's build.zig into two native programs before
# every build (the configurer and the maker), so the seed holds them for each model.
SEED_CPUS = [c for c in os.environ.get("FXC_SEED_CPUS", "cascadelake,skylake_avx512,icelake_server").split(",") if c]
MAX_PROBES = 12

CPU_SEED_SCRIPT = r'''set -e
seed="$HOME/.cache/fxc-zig-seed/fx"; w=/tmp/fxc-cpu
commit="$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))["commit"])' "$seed/meta.json")"
git -C %(ws)s/fx worktree add -q --detach "$w" "$commit"
cp -a --reflink=auto "$seed/cache" "$w/.zig-cache" && mkdir -p "$w/.zig-cache/tmp"
touch /tmp/fxc-cpu-mark && sleep 1
start=$SECONDS
(cd "$w" && zig build -Dtarget=aarch64-macos --prefix zig-out/.fx-cloud-aarch64-macos >/dev/null)
(cd "$w/.zig-cache" && find h o z -newer /tmp/fxc-cpu-mark -type f 2>/dev/null > /tmp/fxc-l.txt || true
 tar -czf /tmp/fxc-cpu-local.tgz -T /tmp/fxc-l.txt)
(cd "$HOME/.cache/zig" && find . -newer /tmp/fxc-cpu-mark -type f ! -path "./tmp/*" > /tmp/fxc-g.txt
 tar -czf /tmp/fxc-cpu-global.tgz -T /tmp/fxc-g.txt)
echo "FXC_CPU_SEED $((SECONDS - start)) $(wc -l < /tmp/fxc-l.txt) $(wc -l < /tmp/fxc-g.txt) $(du -cm /tmp/fxc-cpu-*.tgz | tail -1 | cut -f1)"
'''

CPU_MERGE_SCRIPT = r'''set -e
seed="$HOME/.cache/fxc-zig-seed/fx"
for f in /tmp/fxc-cpu-*-local.tgz; do tar -xzf "$f" --skip-old-files -C "$seed/cache"; done
for f in /tmp/fxc-cpu-*-global.tgz; do tar -xzf "$f" --skip-old-files -C "$HOME/.cache/zig"; done
rm -f /tmp/fxc-cpu-*.tgz
python3 - "$seed/meta.json" %(cpus)s <<'EOF'
import json, sys
meta = json.load(open(sys.argv[1]))
meta["cpus"] = sorted(set(meta.get("cpus", [])) | set(sys.argv[2:]))
json.dump(meta, open(sys.argv[1], "w"))
print("FXC_SEED_CPUS", " ".join(meta["cpus"]))
EOF
'''


def sandbox_cpu(name):
    """The CPU model that Zig sees as native in sandbox NAME."""
    p = subprocess.run(vercel("exec", name, "--", "bash", "-lc",
                              "cd /tmp && zig build-exe --show-builtin 2>/dev/null | grep -m1 -o 'cpu\\.[a-z0-9_]*'"),
                       capture_output=True, text=True)
    m = re.search(r"cpu\.([a-z0-9_]+)", p.stdout)
    return m.group(1) if m else None


def add_cpu_seeds(name, base_cpu, t0, warm):
    """Adds the native build programs of the other CPU models in SEED_CPUS to the seed of base
    sandbox NAME, and takes its snapshot again. Probe sandboxes from the new snapshot make them; a
    model that no probe lands on costs an agent there about 2 minutes on its first build. Any
    failure keeps the first snapshot as the base."""
    global SANDBOX
    want = [c for c in SEED_CPUS if c != base_cpu]
    if not want or not base_cpu:
        return
    snap = read_base()["snapshot"]
    stamp = time.strftime("%H%M%S")
    found, made, lock = {}, [], threading.Lock()

    def probe(i):
        n = "fxc-probe-%s-%d" % (stamp, i)
        if subprocess.call(vercel("create", "--name", n, "--snapshot", snap, "--non-persistent",
                                  "--vcpus", AGENT_VCPUS, "--timeout", "30m", "--tag", "fxc=probe", "--silent"),
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) != 0:
            return
        with lock:
            made.append(n)
        cpu = sandbox_cpu(n)
        with lock:
            if cpu in want and cpu not in found:
                found[cpu] = n

    def run_all(fn, items):
        threads = [threading.Thread(target=fn, args=(it,)) for it in items]
        for th in threads:
            th.start()
        for th in threads:
            th.join()

    results = {}

    def build(cpu):
        n = found[cpu]
        p = subprocess.run(vercel("exec", n, "--", "bash", "-lc", CPU_SEED_SCRIPT % {"ws": shlex.quote(WS)}),
                           capture_output=True, text=True)
        m = re.search(r"FXC_CPU_SEED (\d+) (\d+) (\d+) (\d+)", p.stdout)
        if p.returncode != 0 or not m:
            results[cpu] = "failed (exit %d): %s" % (p.returncode, (p.stdout + p.stderr).strip()[-300:])
            return
        for part in ("local", "global"):
            dest = os.path.join(tmp, "fxc-cpu-%s-%s.tgz" % (cpu, part))
            if subprocess.call(vercel("copy", "%s:/tmp/fxc-cpu-%s.tgz" % (n, part), dest),
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) != 0:
                results[cpu] = "failed: could not copy its %s files" % part
                return
        results[cpu] = (int(m.group(1)), int(m.group(2)), int(m.group(3)), int(m.group(4)))

    say("adding the Zig build programs for the CPU models %s to the seed (the base has %s)"
        % (", ".join(want), base_cpu))
    with tempfile.TemporaryDirectory() as tmp:
        try:
            tried = 0
            while len(found) < len(want) and tried < MAX_PROBES:
                batch = min(4, MAX_PROBES - tried)
                run_all(probe, range(tried, tried + batch))
                tried += batch
            for n in made:  # the probes that no model needs
                if n not in found.values():
                    subprocess.run(vercel("rm", n), capture_output=True)
            missing = [c for c in want if c not in found]
            say("%d probe sandboxes; found %s%s" % (tried, ", ".join(sorted(found)) or "none",
                                                  "; not found: " + ", ".join(missing) if missing else ""))
            run_all(build, list(found))
        finally:
            for n in found.values():
                subprocess.run(vercel("rm", n), capture_output=True)
        good = []
        for cpu in sorted(results):
            r = results[cpu]
            if isinstance(r, tuple):
                good.append(cpu)
                say("  %s: built in %d s, %d local and %d global cache files, %d MB" % ((cpu,) + r))
            else:
                say("  %s: %s" % (cpu, r))
        if not good:
            say("no CPU model was added; the base stays as it is")
            return
        SANDBOX = name

        def give_up(why):
            subprocess.run(vercel("stop", name), capture_output=True)  # it resumed for the files
            say("%s; the base stays as it is" % why)

        if subprocess.run(remote_cmd("true"), capture_output=True).returncode != 0:
            return give_up("could not resume the base sandbox %s" % name)
        for cpu in good:
            for part in ("local", "global"):
                f = "fxc-cpu-%s-%s.tgz" % (cpu, part)
                if subprocess.call(vercel("copy", os.path.join(tmp, f), "%s:/tmp/%s" % (name, f)),
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) != 0:
                    return give_up("upload to the base sandbox failed")
    p = subprocess.run(remote_cmd(CPU_MERGE_SCRIPT % {"cpus": " ".join(shlex.quote(c) for c in good)}),
                       capture_output=True, text=True)
    m = re.search(r"FXC_SEED_CPUS (.*)", p.stdout)
    if p.returncode != 0 or not m:
        return give_up("adding the files failed (exit %d): %s"
                       % (p.returncode, (p.stdout + p.stderr).strip()[-300:]))
    say("the seed now has the build programs for %s" % m.group(1))
    snapshot_base(name, t0, warm)


def cmd_base(args):
    """Builds a new base snapshot, which every new agent sandbox starts from. Each build uses a new
    sandbox, because a snapshot holds every disk block that a sandbox ever changed: a fresh one keeps
    it small, so agent sandboxes start in seconds. The build takes the sign-ins over from the old
    base (or from --from SANDBOX), installs everything with setup.sh, drops the signing key and old
    work with base.sh, warms the caches, takes the snapshot, and then removes the old base sandbox."""
    global SANDBOX
    flags, _ = take_flags(args, ("--no-warm", "--no-cpu-seeds", "--quiet"), valued=("--from",))
    warm = not flags.get("--no-warm")
    with file_lock(os.path.join(STATE_DIR, "base.lock"), wait=False) as held:
        if not held:
            say("a base build runs already")
            return 0
        old = read_base()
        src = flags.get("--from") or (old["sandbox"] if old else FALLBACK)
        name = "%s-%s" % (BASE_NAME, time.strftime("%Y%m%d-%H%M%S"))
        t0 = time.time()
        with tempfile.TemporaryDirectory() as tmp:  # private to this user; removed with its files
            creds = take_credentials(src, tmp) if sandbox_named(src) else None
            say("sign-ins: %s" % ("taken over from %s" % src if creds else "none; run `fx-cloud login` afterwards"))
            say("making the base sandbox %s" % name)
            SANDBOX = name
            if subprocess.call(vercel("create", "--name", name, *CREATE_FLAGS, "--tag", "fxc=base"),
                               stdout=subprocess.DEVNULL) != 0:
                die("could not make the base sandbox")
            bundle = build_bundle(tmp)
            say("uploading the setup bundle (%.1f MB)" % (os.path.getsize(bundle) / 1e6))
            for local, remote in ((bundle, "/tmp/fxc-bundle.tgz"), (creds, "/tmp/fxc-creds.tgz")):
                if local and subprocess.call(vercel("copy", local, "%s:%s" % (name, remote)),
                                             stdout=subprocess.DEVNULL) != 0:
                    die("upload to the base sandbox failed")
        script = ("rm -rf /tmp/fxc && tar -xzf /tmp/fxc-bundle.tgz -C /tmp "
                  "&& { [ ! -f /tmp/fxc-creds.tgz ] || { (umask 077; cd ~ && tar -xzf /tmp/fxc-creds.tgz) "
                  "&& rm -f /tmp/fxc-creds.tgz; }; } "
                  "&& FXC_BASE=1 bash /tmp/fxc/remote/setup.sh /tmp/fxc --no-warm "
                  "&& bash /tmp/fxc/remote/base.sh %s" % ("" if warm else "--no-warm"))
        rc = subprocess.call(remote_cmd(script))
        if rc != 0:
            die("the base build failed (exit %d) in %s; new agent sandboxes still use the old base" % (rc, name))
        base_cpu = sandbox_cpu(name) if warm else None
        snapshot_base(name, t0, warm)
        if warm and not flags.get("--no-cpu-seeds"):
            add_cpu_seeds(name, base_cpu, t0, warm)
        if old and old.get("sandbox") not in (None, name) and old["sandbox"] != FALLBACK:
            # Its snapshot stays while an agent sandbox still uses it.
            subprocess.run(vercel("rm", "--delete-orphan-snapshots", old["sandbox"]), capture_output=True)
            say("removed the old base sandbox %s" % old["sandbox"])
        if not creds:
            say("this base has no sign-ins: run `fx-cloud login` to sign in to fx and GitHub and store the test key")
    return 0


def mac_team():
