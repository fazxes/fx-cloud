def say(msg):
    print("fx-cloud: " + msg, file=sys.stderr)


def die(msg, code=1):
    say(msg)
    sys.exit(code)


def vercel(sub, *args):
    return ["vercel", "sandbox", sub, "--scope", TEAM, "--project", PROJECT] + list(args)


def remote_cmd(script, interactive=False, env=None):
    flags = (["-i"] if interactive else []) + (env or [])
    return vercel("exec", *flags, SANDBOX, "--", "bash", "-lc", script)


def run_remote(script, check=True):
    """Runs a script in the sandbox and returns its stdout. stderr carries the CLI's own banner."""
    p = subprocess.run(remote_cmd(script), capture_output=True, text=True)
    if check and p.returncode != 0:
        sys.stderr.write(p.stderr[-4000:])
        die("sandbox command failed (exit %d): %s" % (p.returncode, script[:120]))
    return p


def interactive(script, extra_env=None):
    """Runs a script on a terminal in the sandbox. Ctrl-C belongs to the remote program, not to us."""
    env = TERM_ENV + (extra_env or [])
    previous = signal.signal(signal.SIGINT, signal.SIG_IGN)
    try:
        child = subprocess.Popen(remote_cmd(script, interactive=True, env=env),
                                 preexec_fn=lambda: signal.signal(signal.SIGINT, signal.SIG_DFL))
        return child.wait()
    finally:
        signal.signal(signal.SIGINT, previous)


def sandbox_exists():
    p = subprocess.run(vercel("list"), capture_output=True, text=True)
    if p.returncode != 0:
        sys.stderr.write(p.stdout[-2000:] + p.stderr[-2000:])
        die("cannot list sandboxes; check `vercel login`")
    return any(line.split()[:1] == [SANDBOX] for line in p.stdout.splitlines())


# --------------------------------------------------------------------------- agent sandboxes

def ps_table():
    """pid -> (parent pid, start time, command line) for every process on the Mac."""
    out = subprocess.run(["ps", "-A", "-o", "pid=,ppid=,lstart=,command="], capture_output=True,
                         text=True).stdout
    procs = {}
    for line in out.splitlines():
        m = re.match(r"\s*(\d+)\s+(\d+)\s+(\w{3}\s+\w{3}\s+\d+\s+[\d:]{8}\s+\d{4})\s+(.*)", line)
        if m:
            procs[int(m.group(1))] = (int(m.group(2)), " ".join(m.group(3).split()), m.group(4))
    return procs


def find_owner(procs=None):
    """The fx process that runs this command: the nearest fx above us that is not a command
    helper. fx keeps its PID and start time when it restarts itself for an update."""
    procs = ps_table() if procs is None else procs
    pid, hops = os.getppid(), 0
    while pid > 1 and pid in procs and hops < 64:
        ppid, start, cmd = procs[pid]
        words = cmd.split()
        if words and os.path.basename(words[0]) == "fx" and "__fx_foreground_session__" not in cmd:
            return {"pid": pid, "start": start, "cmd": cmd[:160]}
        pid, hops = ppid, hops + 1
    return None


def current_owner():
    """(owner id, owner process or None). FXC_OWNER wins. Without an fx above us the owner is the
    shell; then only the idle timeout and `fx-cloud done` end its sandboxes."""
    named = os.environ.get("FXC_OWNER", "").strip()
    if named:
        return "named:" + named, None
    owner = find_owner()
    if owner:
        return "fx:%d@%s" % (owner["pid"], owner["start"]), owner
    return "shell", None


def folder_root(path):
    """The folder a sandbox belongs to: the git worktree around PATH, else PATH itself."""
    p = subprocess.run(["git", "-C", path, "rev-parse", "--show-toplevel"], capture_output=True)
    top = p.stdout.decode().strip()
    return os.path.realpath(top if p.returncode == 0 and top else path)


def agent_name(owner_id, root):
    return AGENT_PREFIX + hashlib.sha1((owner_id + "\0" + root).encode()).hexdigest()[:12]


def entry_path(name):
    return os.path.join(AGENTS_DIR, name + ".json")


def read_entry(name):
    try:
        with open(entry_path(name)) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def write_entry(entry):
    os.makedirs(AGENTS_DIR, exist_ok=True)
    tmp = "%s.%d.tmp" % (entry_path(entry["name"]), os.getpid())
    with open(tmp, "w") as f:
        json.dump(entry, f, indent=1)
    os.replace(tmp, entry_path(entry["name"]))


def all_entries():
    names = sorted(n[:-5] for n in os.listdir(AGENTS_DIR) if n.endswith(".json")) \
        if os.path.isdir(AGENTS_DIR) else []
    return [e for e in (read_entry(n) for n in names) if e]


@contextlib.contextmanager
def file_lock(path, wait=True):
    """An exclusive lock on PATH. Without WAIT, yields False when another process holds it."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "a") as f:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | (0 if wait else fcntl.LOCK_NB))
        except OSError:
            yield False
            return
        try:
            yield True
        finally:
            fcntl.flock(f, fcntl.LOCK_UN)


def read_base():
    try:
        with open(BASE_FILE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def ago(ts):
    s = max(0, int(time.time() - (ts or 0)))
    if s < 3600:
        return "%dm" % (s // 60)
    if s < 86400:
        return "%dh%02dm" % (s // 3600, s % 3600 // 60)
    return "%dd" % (s // 86400)


def set_agent_clock(idle_min):
    """The session clock of an agent sandbox, from the idle time it was made with."""
    global SESSION_TIMEOUT_S, EXTEND_WHEN_LEFT_S, EXTEND_BY, EXTEND_BY_S
    SESSION_TIMEOUT_S = idle_min * 60
    EXTEND_WHEN_LEFT_S = idle_min * 40  # two thirds of the idle time, in seconds
    EXTEND_BY, EXTEND_BY_S = "%dm" % idle_min, idle_min * 60


def drop_local_state(name):
    """Forgets what this Mac knows about sandbox NAME: its entry, its copy caches, its clock."""
    for path in (entry_path(name), os.path.join(STATE_DIR, "extend", name + ".json")):
        try:
            os.unlink(path)
        except OSError:
            pass
    for d in (os.path.join(PUSH_CACHE, name), os.path.join(PLAIN_CACHE, name)):
        shutil.rmtree(d, ignore_errors=True)


def create_agent_sandbox(name, owner_id, owner, root, base):
    live = [e for e in all_entries() if e["name"] != name]
    if len(live) >= MAX_AGENTS:
        # Its lines go to gc.log, as from the background gc: this output is the agent's command output.
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(os.path.join(STATE_DIR, "gc.log"), "a") as log, contextlib.redirect_stdout(log):
            doomed, failed = run_gc(quiet=True)
        say("%d agent sandboxes is the limit; removed %d that no agent needs (~/.cache/fx-cloud/gc.log)"
            % (MAX_AGENTS, len(doomed) - len(failed)))
        live = [e for e in all_entries() if e["name"] != name]
        if len(live) >= MAX_AGENTS:
            say("note: %d agent sandboxes are open (FXC_MAX_AGENTS is %d); `fx-cloud ls` lists them"
                % (len(live), MAX_AGENTS))
    say("starting this agent's sandbox for %s (%s, %s vCPUs, from the base snapshot)"
        % (root.replace(HOME, "~"), name, AGENT_VCPUS))
    t0 = time.time()
    # A create can fail for a short time, for example with 403 Not authorized for about a minute
    # after a new base snapshot (seen Nov 12, 2026), so it gets two more tries.
    for wait in (5, 15, None):
        p = subprocess.run(vercel("create", "--name", name, "--snapshot", base["snapshot"], "--non-persistent",
                                  "--vcpus", AGENT_VCPUS, "--timeout", "%dm" % IDLE_MIN,
                                  "--tag", "fxc=agent", "--silent"), capture_output=True, text=True)
        if p.returncode == 0 or "already" in (p.stdout + p.stderr).lower():
            break
        if wait is None:
            sys.stderr.write((p.stdout + p.stderr)[-2000:])
            die("could not start a sandbox for this agent")
        lines = (p.stdout + p.stderr).strip().splitlines() or ["exit %d" % p.returncode]
        why = next((l for l in lines if "rror" in l), lines[-1]).strip()
        say("starting the sandbox failed (%s); trying again in %d s" % (why[:120], wait))
        time.sleep(wait)
    now = time.time()
    write_entry({"name": name, "owner": owner_id, "owner_pid": owner["pid"] if owner else None,
                 "owner_start": owner["start"] if owner else None, "owner_cmd": owner["cmd"] if owner else "",
                 "root": root, "created": now, "used": now, "snapshot": base["snapshot"], "idle_min": IDLE_MIN})
    say("the sandbox is ready after %.0f s" % (now - t0))
    days = (now - base.get("created", now)) / 86400
    if days > BASE_STALE_DAYS:
        say("note: the base snapshot is %.0f days old; `fx-cloud base` makes a new one" % days)


def use_sandbox(root, create=True):
    """Points this command at its agent's sandbox for ROOT, and starts that sandbox when needed.
    Returns the sandbox's entry, or None for a pinned sandbox or when CREATE is false and none
    exists."""
    global SANDBOX
    if LEGACY:
        SANDBOX = LEGACY
        return None
    base = read_base()
    if not base:
        if fallback_removed():
            die("there is no base snapshot; run: fx-cloud base")
        SANDBOX = FALLBACK
        say("note: no base snapshot yet, so this runs in the shared sandbox %s; run fx-cloud base" % FALLBACK)
        return None
    owner_id, owner = current_owner()
    name = agent_name(owner_id, root)
    SANDBOX = name
    entry = read_entry(name)
    if entry is None:
        if not create:
            return None
        with file_lock(os.path.join(AGENTS_DIR, name + ".lock")):
            entry = read_entry(name)  # a parallel command of the same agent may have started it
            if entry is None:
                create_agent_sandbox(name, owner_id, owner, root, base)
                entry = read_entry(name)
    elif time.time() - entry.get("used", 0) > 60:
        entry["used"] = time.time()
        write_entry(entry)
    set_agent_clock(entry.get("idle_min", IDLE_MIN))
    maybe_background_gc()
    return entry


def restart_sandbox():
    """This command's sandbox is gone, for example removed by gc: start a new one for it."""
    entry = read_entry(SANDBOX)
    root = entry["root"] if entry else folder_root(os.getcwd())
    drop_local_state(SANDBOX)
    say("this agent's sandbox is gone; starting a new one")
    use_sandbox(root)


def detach(argv, log):
    """Starts ARGV fully detached (double fork, new session), so it outlives this command."""
    pid = os.fork()
    if pid:
        os.waitpid(pid, 0)
        return
    try:
        os.setsid()
        if os.fork():
            os._exit(0)
        out = os.open(log, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        null = os.open(os.devnull, os.O_RDONLY)
        os.dup2(null, 0)
        os.dup2(out, 1)
        os.dup2(out, 2)
        os.closerange(3, 4096)
        os.execv(argv[0], argv)
    finally:
        os._exit(1)


def maybe_background_gc():
    """At most every GC_EVERY_S, starts `fx-cloud gc --quiet` in the background."""
    stamp = os.path.join(STATE_DIR, "gc.stamp")
    try:
        if time.time() - os.path.getmtime(stamp) < GC_EVERY_S:
            return
    except OSError:
        pass
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(stamp, "w"):
        pass
    detach([sys.executable, os.path.realpath(__file__), "gc", "--quiet"], os.path.join(STATE_DIR, "gc.log"))


def list_remote():
    """name -> status of every agent sandbox in the project, or None when the list fails. The API
    returns at most 50 per page and prints a --cursor hint when there are more."""
    out, cursor = {}, None
    for _ in range(20):
        p = subprocess.run(vercel("list", "--all", "--name-prefix", AGENT_PREFIX, "--limit", "50",
                                  *(["--cursor", cursor] if cursor else [])), capture_output=True, text=True)
        if p.returncode != 0:
            return None
        for line in p.stdout.splitlines():
            w = line.split()
            if len(w) >= 2 and w[0].startswith(AGENT_PREFIX):
                out[w[0]] = w[1]
        m = re.search(r"--cursor[= ]+['\"]?([A-Za-z0-9_\-=.]+)", p.stdout + p.stderr)
        if not m or m.group(1) == cursor:
            break
        cursor = m.group(1)
    return out


def remove_sandboxes(names):
    """Removes sandboxes and forgets them on this Mac. Returns the names it could not remove."""
    names = sorted(set(names))
    if not names:
        return []
    failed = []
    if subprocess.run(vercel("rm", "--delete-orphan-snapshots", *names), capture_output=True).returncode != 0:
        for n in names:  # one bad name fails the whole call, so try them one at a time
            q = subprocess.run(vercel("rm", "--delete-orphan-snapshots", n), capture_output=True, text=True)
            if q.returncode != 0 and "not found" not in (q.stdout + q.stderr):
                failed.append(n)
    for n in names:
        if n not in failed:
            drop_local_state(n)
    return failed


def owner_alive(entry, procs):
    pid = entry.get("owner_pid")
    if not pid:
        return True  # a named or shell owner: the idle timeout and `fx-cloud done` end it
    p = procs.get(pid)
    return bool(p and p[1] == entry.get("owner_start"))


STOPPED = ("stopped", "failed", "aborted", "error")


def run_gc(everything=False, quiet=False):
    """Removes the agent sandboxes that no agent needs: the fx process that owns one ended, its
    folder is gone, or it stopped after being idle. EVERYTHING removes every agent sandbox."""
    procs, entries, remote = ps_table(), all_entries(), list_remote()
    doomed = {}
    for e in entries:
        n = e["name"]
        if remote is not None and n not in remote and time.time() - e.get("created", 0) > 300:
            drop_local_state(n)  # already removed elsewhere
        elif everything:
            doomed[n] = "asked"
        elif not owner_alive(e, procs):
            doomed[n] = "its fx process ended"
        elif not os.path.isdir(e["root"]):
            doomed[n] = "its folder is gone"
        elif remote and remote.get(n) in STOPPED:
            doomed[n] = "it stopped after %d idle minutes" % IDLE_MIN
    known = {e["name"] for e in entries}
    for n, status in (remote or {}).items():
        if n not in known and (everything or status in STOPPED):
            doomed[n] = "no agent on this Mac uses it"
    failed = remove_sandboxes(list(doomed))
    stamp = time.strftime("%Y-%m-%d %H:%M:%S")
    for n, why in sorted(doomed.items()):
        print("%s %s %s: %s" % (stamp, "could not remove" if n in failed else "removed", n, why))
    if quiet:
        print("%s gc: %d agent sandboxes known, %d running, %d removed" % (
            stamp, len(entries), sum(1 for s in (remote or {}).values() if s == "running"),
            len(doomed) - len(failed)))
    elif not doomed:
        print("nothing to remove")
    return doomed, failed


def cmd_gc(args):
    log = os.path.join(STATE_DIR, "gc.log")
    if "--quiet" in args and os.path.exists(log) and os.path.getsize(log) > 1 << 20:
        os.replace(log, log + ".old")
    with file_lock(os.path.join(STATE_DIR, "gc.lock"), wait="--quiet" not in args) as held:
        if not held:
            return 0  # another gc runs now
        _, failed = run_gc(everything="--all" in args, quiet="--quiet" in args)
    return 1 if failed else 0


def cmd_ls(_args):
    procs, entries, remote = ps_table(), all_entries(), list_remote() or {}
    known = {e["name"] for e in entries}
    if not entries and not remote:
        print("no agent sandboxes")
        return 0
    print("%-16s %-8s %-28s %-6s %-6s %s" % ("SANDBOX", "STATE", "AGENT", "AGE", "IDLE", "FOLDER"))
    for e in sorted(entries, key=lambda e: e.get("created", 0)):
        if e.get("owner_pid"):
            agent = "fx %d (%s)" % (e["owner_pid"], "running" if owner_alive(e, procs) else "ended")
        else:
            agent = e.get("owner", "").replace("named:", "")
        print("%-16s %-8s %-28s %-6s %-6s %s" % (e["name"], remote.get(e["name"], "gone"), agent[:28],
                                                 ago(e.get("created")), ago(e.get("used")),
                                                 e["root"].replace(HOME, "~")))
    for n, status in sorted(remote.items()):
        if n not in known:
            print("%-16s %-8s %-28s" % (n, status, "(not known on this Mac)"))
    return 0


def cmd_done(args):
    if LEGACY:
        die("FXC_SANDBOX is set; `fx-cloud done` removes only agent sandboxes")
    owner_id, _ = current_owner()
    if "--all" in args:
        names = [e["name"] for e in all_entries() if e.get("owner") == owner_id]
    else:
        name = agent_name(owner_id, folder_root(os.getcwd()))
        names = [name] if read_entry(name) else []
    if not names:
        say("this agent has no sandbox%s" % ("" if "--all" in args else " for this folder"))
        return 0
    failed = remove_sandboxes(names)
    for n in names:
        say("%s %s" % ("could not remove" if n in failed else "removed", n))
    return 1 if failed else 0


