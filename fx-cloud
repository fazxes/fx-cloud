def kill_remote(pidfile):
    script = ('pg=$(cat %s 2>/dev/null) || exit 0; kill -TERM -- -"$pg" 2>/dev/null; '
              'sleep 3; kill -KILL -- -"$pg" 2>/dev/null; rm -f %s') % (pidfile, pidfile)
    subprocess.run(remote_cmd(script), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=60)


class Extender:
    """Keeps the sandbox session alive while fx-cloud uses it. The helper reports the session's
    uptime; the session ends at its timeout plus the time added so far, so add time before that."""

    @property
    def STATE(self):  # noqa: N802 - one clock file for each sandbox
        return os.path.join(STATE_DIR, "extend", (SANDBOX or "none") + ".json")

    def __init__(self):
        self.seen = None  # (boot id, uptime, local time when seen)
        self.worker = None
        self.lock = threading.Lock()

    def observe(self, clock):
        if clock.get("boot") and "uptime" in clock:
            self.seen = (clock["boot"], float(clock["uptime"]), time.time())
            self.check()

    def added(self, boot):
        try:
            with open(self.STATE) as f:
                d = json.load(f)
            return d.get("added_s", 0) if d.get("boot") == boot else 0
        except (OSError, ValueError):
            return 0

    def check(self):
        if not self.seen:
            return
        boot, uptime, seen_at = self.seen
        added = self.added(boot)
        left = SESSION_TIMEOUT_S + added - (uptime + time.time() - seen_at)
        with self.lock:
            if left >= EXTEND_WHEN_LEFT_S or (self.worker and self.worker.is_alive()):
                return
            self.worker = threading.Thread(target=self.extend, args=(boot, added), daemon=True)
            self.worker.start()

    def extend(self, boot, added):
        rc = subprocess.call(vercel("extend", SANDBOX, EXTEND_BY),
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if rc == 0:
            os.makedirs(os.path.dirname(self.STATE), exist_ok=True)
            with open(self.STATE, "w") as f:
                json.dump({"boot": boot, "added_s": added + EXTEND_BY_S}, f)
        else:
            say("could not add time to the sandbox session; your plan may limit one session's length")

    def finish(self):
        if self.worker:
            self.worker.join(timeout=30)


EXTENDER = Extender()


def remote_stream(script, capture=False, pidfile=None, _retry=True):
    """Runs a script in the sandbox. Its stdout streams to ours (or is captured), its stderr streams
    without the Vercel CLI banner, and FXC:: lines from the helper come back as results.
    A stop signal also stops the remote command. When an agent sandbox is gone, a new one starts
    and the script runs once more; the copy steps around it then fill the new sandbox."""
    p = subprocess.Popen(remote_cmd(script), stdout=subprocess.PIPE if capture else None,
                         stderr=subprocess.PIPE, start_new_session=True)
    results, before = [], []
    started = [False]

    def pump():
        for raw in iter(p.stderr.readline, b""):
            line = raw.decode("utf-8", "replace")
            if line.startswith("FXC::"):
                try:
                    result = json.loads(line[5:])
                except ValueError:
                    continue
                if "uptime" in result:
                    EXTENDER.observe(result)  # the session clock, sent as a command starts
                else:
                    results.append(result)
                continue
            if not started[0]:
                if line.startswith("$ "):
                    started[0] = True  # the CLI echoes the command; remote output follows
                else:
                    before.append(line)
                continue
            sys.stderr.write(line)
            sys.stderr.flush()

    reader = threading.Thread(target=pump, daemon=True)
    reader.start()
    stopped = []

    def on_signal(signum, _frame):
        if stopped:
            return
        stopped.append(signum)
        say("stopping the command in the sandbox")
        if pidfile:
            try:
                kill_remote(pidfile)
            except Exception:  # noqa: BLE001
                pass
        p.terminate()

    done = threading.Event()

    def tick():  # long commands keep the session alive; check well before the threshold passes
        while not done.wait(max(30, min(300, EXTEND_WHEN_LEFT_S // 3))):
            EXTENDER.check()

    threading.Thread(target=tick, daemon=True).start()
    old = {s: signal.signal(s, on_signal) for s in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP)}
    try:
        out = p.stdout.read() if capture else b""
        rc = p.wait()
    finally:
        done.set()
        for s, h in old.items():
            signal.signal(s, h)
    reader.join(timeout=5)
    EXTENDER.finish()
    if not started[0] and rc != 0 and not results:
        text = "".join(before)
        if _retry and not stopped and is_agent_name(SANDBOX) and "not found for this project" in text:
            restart_sandbox()
            return remote_stream(script, capture=capture, pidfile=pidfile, _retry=False)
        sys.stderr.write(text)
    if stopped:
        rc = 128 + stopped[0]
    return rc, results, out


def is_old_helper(rc, last):
    return rc == OLD_HELPER and last.get("error") == "old_helper"


def helper_call(op, *args, capture=False):
    """One helper op, with one retry after updating an old helper."""
    for attempt in range(2):
        rc, results, out = remote_stream(helper_script(op, *args), capture=capture)
        last = results[-1] if results else {}
        if attempt == 0 and is_old_helper(rc, last):
            upload_helper()
            continue
        return rc, results, out


def mac_excludes(top):
    """The Mac's ignore rules for this repository: its info/exclude and the global excludes file."""
    parts = []
    common = lgit_out(top, "rev-parse", "--git-common-dir")
    if not os.path.isabs(common):
        common = os.path.join(top, common)
    gx = lgit(top, "config", "--path", "core.excludesFile", check=False).stdout.decode().strip()
    if not gx:
        gx = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"), "git", "ignore")
    for path in (os.path.join(common, "info", "exclude"), os.path.expanduser(gx)):
        if os.path.isfile(path):
            with open(path, errors="replace") as f:
                parts.append(f.read())
    return "\n".join(parts)


def default_remote_ref(top):
    for ref in ("refs/remotes/origin/HEAD", "refs/remotes/origin/main", "refs/remotes/origin/master"):
        if lgit(top, "rev-parse", "--verify", "-q", ref, check=False).returncode == 0:
            return ref
    return None


def make_bundle(st, strategy, path):
    ref = "refs/fx-cloud/" + st["key"]
    lgit(st["top"], "update-ref", ref, st["cwip"])
    try:
        args = ["bundle", "create", "-q", path, ref]
        if strategy == "remotes":
            args += ["--not", "--remotes=origin"]
        elif strategy == "merge-base":
            base_ref = default_remote_ref(st["top"])
            if not base_ref:
                return False
            mb = lgit(st["top"], "merge-base", st["sha"], base_ref, check=False)
            if mb.returncode != 0:
                return False
            args += ["--not", mb.stdout.decode().strip()]
        lgit(st["top"], *args)
        return True
    finally:
        lgit(st["top"], "update-ref", "-d", ref, check=False)


def cache_path(st):
    return os.path.join(PUSH_CACHE, SANDBOX, st["key"] + ".json")


def cache_says_synced(st):
    """True when the last successful sandbox call saw exactly this commit and these files."""
    try:
        with open(cache_path(st)) as f:
            c = json.load(f)
        return c.get("sha") == st["sha"] and c.get("tree") == st["tree"]
    except (OSError, ValueError):
        return False


def remember_synced(st):
    os.makedirs(os.path.dirname(cache_path(st)), exist_ok=True)
    tmp = cache_path(st) + ".tmp"
    with open(tmp, "w") as f:
        json.dump({"sha": st["sha"], "tree": st["tree"], "top": st["top"]}, f)
    os.replace(tmp, cache_path(st))


def forget_synced(st):
    try:
        os.unlink(cache_path(st))
    except OSError:
        pass


def copy_payload(st, strategy, tmp):
    """The bundle and ignore rules for `apply`: inline in the command when small, else uploaded.
    Returns (bundle_arg, exclude_arg, cleanup, size), or None when STRATEGY cannot build a bundle."""
    path = os.path.join(tmp, "copy.bundle")
    if not make_bundle(st, strategy, path):
        return None
    exclude = mac_excludes(st["top"]).encode()
    exclude_arg = ("b64:" + base64.b64encode(exclude).decode()) if len(exclude) <= INLINE_LIMIT else "-"
    size = os.path.getsize(path)
    if size <= INLINE_LIMIT:
        with open(path, "rb") as f:
            return "b64:" + base64.b64encode(f.read()).decode(), exclude_arg, "", size
    remote = "/tmp/fxc-push-%s.bundle" % st["key"]
    say("uploading %s of commits and changes" % human(size))
    rc = subprocess.call(vercel("copy", path, "%s:%s" % (SANDBOX, remote)),
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if rc != 0:
        die("upload to the sandbox failed")
    return remote, exclude_arg, "; rc=$?; rm -f %s; exit $rc" % remote, size


def report_sandbox_changed(files):
    say("the sandbox copy has changes that are not on the Mac, so it was not overwritten:")
    for line in files[:20]:
        print("    " + line.replace("\t", " "), file=sys.stderr)
    if len(files) > 20:
        print("    ... and %d more" % (len(files) - 20), file=sys.stderr)
    say("see them with `fx-cloud pull --patch`, take them with `fx-cloud pull --patch --apply`, "
        "or discard them with `--force`")


def run_plain(script, capture):
    """Runs SCRIPT in the sandbox without copying anything."""
    for attempt in range(2):
        pidfile = "/tmp/fxc-runs/%s.pid" % uuid.uuid4().hex
        rc, results, out = remote_stream(
            helper_script("run", "-", os.path.realpath(os.getcwd()), "-", "-", "-", "-", pidfile, script),
            capture=capture, pidfile=pidfile)
        if attempt == 0 and is_old_helper(rc, results[-1] if results else {}):
            upload_helper()
            continue
        return rc, out


def run_checked_and_ran(st, script, capture=False, force=False):
    """Runs SCRIPT in the sandbox copy of the worktree. When the copy may differ from the Mac, the
    same sandbox call first makes it match, so a changed worktree usually costs one call. Returns
    (rc, out, ran); ran is False when the sandbox did not start SCRIPT."""
    if st is None:
        return run_plain(script, capture) + (True,)
    strategies = None
    copy = force or not cache_says_synced(st)
    helper_updated = False
    for _ in range(6):
        pidfile = "/tmp/fxc-runs/%s.pid" % uuid.uuid4().hex
        run = helper_script("run", st["top"], st["cwd"], st["sha"], st["tree"], st.get("cwip", "-"),
                            st["inc_arg"], pidfile, script)
        with tempfile.TemporaryDirectory() as tmp:
            remote = run
            if copy:
                copy_info(st)
                if strategies is None:
                    strategies = ["remotes", "merge-base", "full"] if st["origin"] else ["full"]
                payload = None
                while strategies and payload is None:
                    payload = copy_payload(st, strategies[0], tmp)
                    if payload is None:
                        strategies.pop(0)
                if payload is None:
                    die("cannot send the commits to the sandbox")
                bundle_arg, exclude_arg, cleanup, size = payload
                say("copying %s to the sandbox (%s)" % (short(st["top"]), human(size)))
                apply = helper_script("apply", st["top"], st["sha"], st["tree"], st["cwip"], st["inc_arg"],
                                      st["origin"], bundle_arg, exclude_arg, "1" if force else "0")
                remote = "(" + apply + " && " + run + ")" + cleanup
            rc, results, out = remote_stream(remote, capture=capture, pidfile=pidfile)
        last = results[-1] if results else {}
        if not helper_updated and is_old_helper(rc, last):
            upload_helper()
            helper_updated = True
            continue
        changed = next((r for r in results if "sandbox_changed" in r), None)
        if changed:
            forget_synced(st)
            report_sandbox_changed(changed["sandbox_changed"])
            return 1, out, False
        err = next((r for r in results if r.get("error")), None)
        if err and err["error"] == "prerequisite" and strategies and len(strategies) > 1:
            strategies.pop(0)  # the sandbox lacks commits the bundle builds on; send more history
            continue
        if err:
            forget_synced(st)
            say("sandbox: %s %s" % (err["error"], err.get("detail", "")))
            return 1, out, False
        if rc == NEEDS_PUSH and last.get("needs_push"):
            if copy:
                die("the sandbox copy still differs after copying; run with --force")
            copy = True  # the remembered state was stale
            continue
        applied = next((r for r in results if r.get("ok")), None)
        if applied and not applied.get("tree_match", True):
            say("note: the sandbox copy differs from the Mac in ignored or special files")
        remember_synced(st)
        return rc, out, True
    die("the sandbox copy did not settle after several tries")


def run_checked(st, script, capture=False, force=False):
    """Runs SCRIPT like run_checked_and_ran, and returns only (rc, out)."""
    rc, out, _ = run_checked_and_ran(st, script, capture=capture, force=force)
    return rc, out


def plain_state(path):
    """A folder that is not a git worktree: its files (without build folders), their hashes, and
    one digest of all of them. Hashes are reused while a file's size and time stay the same."""
    root = os.path.realpath(path)
    refused = {"/", HOME, os.path.dirname(HOME), "/tmp", "/private", "/private/tmp", "/var",
               "/private/var", os.path.realpath(tempfile.gettempdir())}
    if root in refused:
        die("will not copy %s to the sandbox; run fx-cloud from a project folder" % root)
    key = hashlib.sha1(root.encode()).hexdigest()[:12]
    cache_file = os.path.join(PLAIN_CACHE, key + ".hashes.json")
    try:
        with open(cache_file) as f:
            cache = json.load(f)
    except (OSError, ValueError):
        cache = {}
    manifest, fresh, total = {}, {}, 0
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = sorted(d for d in dirnames if d not in PLAIN_SKIP and not (
            os.path.basename(dirpath) == "states" and re.match(r"\d\d-\d\d-\d\d-", d)))  # TLC state folders
        for name in filenames:
            if name in PLAIN_SKIP:
                continue
            full = os.path.join(dirpath, name)
            try:
                st = os.lstat(full)
            except OSError:
                continue
            if not (st.st_mode & 0o170000 == 0o100000):
                continue  # regular files only
            total += st.st_size
            if total > PLAIN_LIMIT:
                die("%s holds more than %s without its build folders; fx-cloud copies folders outside git "
                    "only up to that size. Make it a git repository, or run from a smaller folder."
                    % (root, human(PLAIN_LIMIT)))
            rel = os.path.relpath(full, root)
            stamp = [st.st_size, st.st_mtime_ns]
            old = cache.get(rel)
            if old and old[:2] == stamp:
                digest = old[2]
            else:
                h = hashlib.sha256()
                with open(full, "rb") as f:
                    for chunk in iter(lambda: f.read(1 << 20), b""):
                        h.update(chunk)
                digest = h.hexdigest()
            fresh[rel] = stamp + [digest]
            manifest[rel] = [digest, 1 if st.st_mode & 0o111 else 0]
    os.makedirs(PLAIN_CACHE, exist_ok=True)
    with open(cache_file + ".tmp", "w") as f:
        json.dump(fresh, f)
    os.replace(cache_file + ".tmp", cache_file)
    digest = hashlib.sha256(json.dumps(sorted(manifest.items())).encode()).hexdigest()
    return {"root": root, "cwd": root, "key": key, "manifest": manifest, "digest": digest, "bytes": total}


def run_checked_plain(ps, script, capture=False, force=False):
    """Runs SCRIPT in a one-way copy of a plain folder. Only changed files move; files that the
    sandbox made are kept unless the Mac has a file at the same path."""
    sent_file = os.path.join(PLAIN_CACHE, SANDBOX, ps["key"] + ".sent.json")
    try:
        with open(sent_file) as f:
            sent = json.load(f)
    except (OSError, ValueError):
        sent = {}
    copy = force or sent.get("digest") != ps["digest"]
    full = force or not sent
    helper_updated = False
    for _ in range(5):
        pidfile = "/tmp/fxc-runs/%s.pid" % uuid.uuid4().hex
        run = helper_script("runplain", ps["root"], ps["cwd"], ps["digest"], pidfile, script)
        remote, cleanup = run, ""
        with tempfile.TemporaryDirectory() as tmp:
            if copy:
                base = {} if full else sent.get("manifest", {})
                changed = sorted(r for r, v in ps["manifest"].items() if base.get(r) != v)
                deleted = sorted(r for r in base if r not in ps["manifest"])
                tar_arg = "-"
                if changed:
                    tgz = os.path.join(tmp, "plain.tgz")
                    with tarfile.open(tgz, "w:gz") as tar:
                        for rel in changed:
                            tar.add(os.path.join(ps["root"], rel), arcname=rel, recursive=False)
                    size = os.path.getsize(tgz)
                    if size <= INLINE_LIMIT:
                        with open(tgz, "rb") as f:
                            tar_arg = "b64:" + base64.b64encode(f.read()).decode()
                    else:
                        tar_arg = "/tmp/fxc-plain-%s.tgz" % ps["key"]
                        rc = subprocess.call(vercel("copy", tgz, "%s:%s" % (SANDBOX, tar_arg)),
                                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                        if rc != 0:
                            die("upload to the sandbox failed")
                        cleanup = "; rc=$?; rm -f %s; exit $rc" % tar_arg
                say("copying %d changed file(s) of %s to the sandbox, one way (not a git worktree)"
                    % (len(changed), short(ps["root"])))
                apply = helper_script("applyplain", ps["root"], ps["digest"],
                                      "-" if full else sent.get("digest", "-"), tar_arg, encode_list(deleted))
                remote = "(" + apply + " && " + run + ")" + cleanup
            rc, results, out = remote_stream(remote, capture=capture, pidfile=pidfile)
        last = results[-1] if results else {}
        if not helper_updated and is_old_helper(rc, last):
            upload_helper()
            helper_updated = True
            continue
        err = next((r for r in results if r.get("error")), None)
        if err:
            say("sandbox: %s %s" % (err["error"], err.get("detail", "")))
            return 1, out
        if rc == NEEDS_PUSH and last.get("needs_push"):
            if copy and full:
                die("the sandbox copy still differs after a full copy")
            copy, full = True, bool(copy or last.get("needs_full") or last.get("remote_digest") != sent.get("digest"))
            continue
        os.makedirs(os.path.dirname(sent_file), exist_ok=True)
        with open(sent_file + ".tmp", "w") as f:
            json.dump({"digest": ps["digest"], "manifest": ps["manifest"]}, f)
        os.replace(sent_file + ".tmp", sent_file)
        return rc, out
    die("the sandbox copy did not settle after several tries")


def human(n):
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return ("%d %s" % (n, unit)) if unit == "B" else ("%.1f %s" % (n, unit))
        n /= 1024.0


def take_flags(args, flags, valued=(), multi=()):
    """Reads leading --flags; stops at the first other word or at --. MULTI flags take a value
    and may repeat; their values come back as a list."""
    got, rest = {}, list(args)
    while rest:
        a = rest[0]
        if a == "--":
            rest.pop(0)
            break
        if a in flags:
            got[a] = True
            rest.pop(0)
        elif a in multi and len(rest) > 1:
            got.setdefault(a, []).append(rest[1])
            del rest[:2]
        elif a in valued and len(rest) > 1:
            got[a] = rest[1]
            del rest[:2]
        else:
            break
    return got, rest


def run_here(script, flags, capture=False):
    """Runs SCRIPT in the sandbox copy of the current folder: a synced copy of a git worktree, or a
    one-way copy of a plain folder."""
    force = flags.get("--force", False)
    if flags.get("--no-push"):
        use_sandbox(folder_root(os.getcwd()))
        return run_checked(None, script, capture=capture)
    st = local_state(os.getcwd(), flags.get("--include", []))
    if st is not None:
        use_sandbox(st["top"])
        return run_checked(st, script, capture=capture, force=force)
    if flags.get("--include"):
        say("note: --include matters only in git worktrees; a plain folder copies all its files")
    ps = plain_state(os.getcwd())
    use_sandbox(ps["root"])
    return run_checked_plain(ps, script, capture=capture, force=force)


def run_here_and_ran(script):
    """Runs SCRIPT the way run_here(script, {}) does, and also says whether the sandbox started it.
    A plain folder always counts as started."""
    st = local_state(os.getcwd(), [])
    if st is None:
        rc, out = run_here(script, {})
        return rc, out, True
    use_sandbox(st["top"])
    return run_checked_and_ran(st, script)


def cmd_run(args):
    flags, rest = take_flags(args, ("--no-push", "--force"), multi=("--include",))
    if not rest:
        die("usage: fx-cloud run [--no-push] [--force] [--include PATH]... <command>", 2)
    script = rest[0] if len(rest) == 1 else shlex.join(rest)
    rc, _ = run_here(script, flags)
    return rc


def cmd_push(args):
    flags, _ = take_flags(args, ("--force",), multi=("--include",))
    rc, _ = run_here("true", flags)
    if rc == 0:
        say("the sandbox copy of %s matches the Mac" % short(os.path.realpath(os.getcwd())))
    return rc


def build_out(target):
    """The sandbox folder that a build for TARGET installs to before the copy to the Mac. It is
    the same every time: a project's build.zig may put the install folder into the options its
    modules import (fx does), so a new folder would make Zig compile everything again."""
    return "zig-out/.fx-cloud-" + re.sub(r"[^A-Za-z0-9_.-]", "_", target)


def zig_arch():
    machine = platform.machine().lower()
    return {"arm64": "aarch64", "aarch64": "aarch64", "amd64": "x86_64", "x86_64": "x86_64"}.get(machine, machine)


def mac_target():
    return "%s-macos" % ("aarch64" if zig_arch() == "aarch64" else "x86_64")


def host_target():
    """The Zig target of this computer, for builds that come back here."""
    return mac_target() if sys.platform == "darwin" else "%s-linux" % zig_arch()


def cmd_macos_build(args):
    """Builds the macOS binary of a Zig project in the sandbox, and puts it in the Mac worktree's
    zig-out/bin. The sandbox's own zig-out/bin keeps its Linux binary."""
    st = local_state(os.getcwd())
    if st is None:
        die("run fx-cloud macos-build from inside a git worktree of a Zig project")
    use_sandbox(st["top"])
    out = build_out(mac_target())
    script = "zig build -Dtarget=%s --prefix %s" % (mac_target(), out)
    if args:
        script += " " + shlex.join(args)
    rc, _ = run_checked(st, script)
    if rc != 0:
        return rc
    rc, results, _ = helper_call("tar", st["top"], out + "/bin")
    last = results[-1] if results else {}
    if rc != 0:
        die("sandbox: %s" % last.get("error", "exit %d" % rc))
    with tempfile.TemporaryDirectory() as tmp:
        tgz = os.path.join(tmp, "bin.tgz")
        if subprocess.call(vercel("copy", "%s:%s" % (SANDBOX, last["tarball"]), tgz),
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) != 0:
            die("download failed")
        count = extract_plain(tgz, os.path.join(st["top"], "zig-out"))
    say("the macOS build from the sandbox is in %s/zig-out/bin (%d %s)"
        % (short(st["top"]), count, "file" if count == 1 else "files"))
    return 0


def cmd_agent(args):
    flags, rest = take_flags(args, ("--no-push", "--force"), valued=("--resume",), multi=("--include",))
    if not rest:
        die('usage: fx-cloud agent [--resume ID] [--include PATH]... "<task>"', 2)
    task = " ".join(rest)
    cmd = list(CFG["agent_command"]) + ["ask", "--json"]
    if flags.get("--resume"):
        cmd += ["--resume", flags["--resume"], task]
    else:
        cmd += [HANDOFF + task]
    st = None if flags.get("--no-push") else local_state(os.getcwd(), flags.get("--include", []))
    say("handing the task to %s in the sandbox; its progress follows" % CFG["agent_command"][0])
    rc, out = run_here(shlex.join(cmd), flags, capture=True)
    try:
        result = json.loads(out.decode("utf-8", "replace"))
    except ValueError:
        sys.stdout.write(out.decode("utf-8", "replace"))
        say("the agent in the sandbox returned no JSON result (exit %d)" % rc)
        return rc or 1
    print((result.get("final_output") or result.get("output") or "").rstrip())
    print()
    sid = result.get("session_id") or ""
    print("sandbox session: %s   exit: %s   steps: %s" % (sid or "(not saved)", result.get("exit_code", rc),
                                                         result.get("steps", "?")))
    if st:
        _, results, _ = helper_call("changes", st["top"])
        files = (results[-1] if results else {}).get("files", [])
        if files:
            print("changed in the sandbox copy (take them with `fx-cloud pull --patch --apply`):")
            for line in files[:40]:
                print("  " + line.replace("\t", " "))
        else:
            print("no files changed in the sandbox copy")
    elif not flags.get("--no-push"):
        print("this folder is not a git worktree, so its sandbox copy is one way; "
              "bring files back with `fx-cloud pull <path>`")
    if sid:
        print("continue it with: fx-cloud agent --resume %s \"<next step>\"" % sid)
    return rc


def cmd_pull(args):
    flags, rest = take_flags(args, ("--patch", "--apply"))
    st = local_state(os.getcwd())
    root = st["top"] if st else os.path.realpath(os.getcwd())
    if use_sandbox(root, create=False) is None:
        die("this agent has no sandbox for %s, so there is nothing to pull" % short(root))
    if flags.get("--patch"):
        if st is None:
            die("run fx-cloud pull --patch from inside a git worktree")
        rc, results, patch = helper_call("patch", st["top"], capture=True)
        last = results[-1] if results else {}
        if rc != 0:
            die("sandbox: %s" % last.get("error", "exit %d" % rc))
        files = last.get("files", [])
        if not files:
            say("the sandbox copy has no changes since the last copy")
            return 0
        if not flags.get("--apply"):
            sys.stdout.buffer.write(patch)
            return 0
        check = subprocess.run(["git", "-C", st["top"], "apply", "--check", "--binary", "-"],
                               input=patch, capture_output=True)
        if check.returncode != 0:
            sys.stderr.write(check.stderr.decode(errors="replace"))
            die("the patch does not apply to the Mac worktree; nothing changed. "
                "See it with `fx-cloud pull --patch`.")
        lgit(st["top"], "apply", "--binary", "-", data=patch)
        say("applied the sandbox changes to %s:" % short(st["top"]))
        for line in files:
            print("  " + line.replace("\t", " "))
        return 0
    if not rest:
        die("usage: fx-cloud pull --patch [--apply] | fx-cloud pull <path> [<dest>]", 2)
    src, dest = rest[0], (rest[1] if len(rest) > 1 else ".")
    rc, results, _ = helper_call("tar", os.path.realpath(os.getcwd()), src)
    last = results[-1] if results else {}
    if rc != 0:
        die("sandbox: %s" % last.get("error", "exit %d" % rc))
    with tempfile.TemporaryDirectory() as tmp:
        tgz = os.path.join(tmp, "pull.tgz")
        rc = subprocess.call(vercel("copy", "%s:%s" % (SANDBOX, last["tarball"]), tgz),
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if rc != 0:
            die("download failed")
        os.makedirs(dest, exist_ok=True)
        count = extract_plain(tgz, dest)
    say("copied %s to %s (%d %s)" % (src, dest, count, "file" if count == 1 else "files"))
    return 0


# --------------------------------------------------------------------------- zig and bun shims
#
# shims/zig and shims/bun come before the real tools in PATH (install.sh --shims) and call
# `fx-cloud zig|bun --real <path> -- <args>`. Heavy builds and tests run in the agent's sandbox;
# everything else, every command in a `local_only` project, and every command with FXC_LOCAL=1
# runs the real tool here.

# zig build options that take their value as the next word.
ZIG_VALUE_OPTS = {"-p", "--prefix", "--prefix-lib-dir", "--prefix-exe-dir", "--prefix-include-dir",
                  "--sysroot", "--search-prefix", "--libc", "--build-file", "--cache-dir",
                  "--global-cache-dir", "--zig-lib-dir", "--build-runner", "--summary", "--seed",
                  "--maxrss", "--color", "--debug-log", "--test-timeout", "-j"}


def zig_build_parts(args):
    """(steps, prefix, target given) of `zig build` ARGS, which follow the word `build`."""
    steps, prefix, target, i = [], None, False, 0
    while i < len(args):
        a = args[i]
        if a == "--":
            break  # arguments for the program that a run step starts
        if a in ZIG_VALUE_OPTS:
            if a in ("-p", "--prefix") and i + 1 < len(args):
                prefix = args[i + 1]
            i += 2
            continue
        if a.startswith("--prefix="):
            prefix = a.split("=", 1)[1]
        elif a.startswith("-Dtarget="):
            target = True
        elif not a.startswith("-"):
            steps.append(a)
        i += 1
    return steps, prefix, target


def local_only_match(root, origin, names):
    """True when a `local_only` name is part of the origin URL, or starts a folder name in ROOT."""
    return any(name in origin or ("/" + name) in root for name in names if name)


def project_allows_remote(path):
    """False for folders fx-cloud must not copy and for `local_only` projects."""
    root = folder_root(path)
    if root in ("/", HOME, "/tmp", "/private/tmp") or root.startswith("/System"):
        return False
    origin = subprocess.run(["git", "-C", path, "config", "--get", "remote.origin.url"],
                            capture_output=True, text=True).stdout.strip()
    return not local_only_match(root, origin, CFG["local_only"])


def zig_route(args):
    """local, remote-install (build for this computer there and copy it here), or remote-run."""
    if not args or args[0] not in ("build", "test"):
        return "local"
    if args[0] == "test":
        return "remote-run"
    rest = args[1:]
    if any(a in ("-h", "--help", "-l", "--list-steps", "--build-runner") for a in rest):
        return "local"  # help, step lists, and editor tooling
    steps, _, _ = zig_build_parts(rest)
    if "run" in steps:
        return "local"  # starts the program here, for hands-on use
    return "remote-install" if steps in ([], ["install"]) else "remote-run"


def bun_route(args):
    if not args:
        return "local"
    if args[0] == "test":
        return "remote-run"
    first = args[0][2:] if args[0].startswith("./") else args[0]
    if first.endswith((".ts", ".mjs", ".js")) and (
            "tests/" in first or (os.path.isfile(first) and "/tests/" in os.path.realpath(first))):
        return "remote-run"  # Bun drivers and harnesses under tests/, also from inside their folder
    return "local"


def shim_args(args):
    flags, rest = take_flags(args, (), valued=("--real",))
    real = flags.get("--real")
    if not real or not os.access(real, os.X_OK):
        die("the shim found no real binary; set FXC_LOCAL=1 or check PATH", 127)
    return real, rest


def shim_exec_local(real, tool, args):
    os.execv(real, [tool] + list(args))


def cmd_zig(args):
    real, rest = shim_args(args)
    route = zig_route(rest)
    if route != "local" and not project_allows_remote(os.getcwd()):
        route = "local"
    if os.environ.get("FXC_SHIM_DRYRUN"):
        print("zig %s -> %s" % (shlex.join(rest), route))
        return 0
    if route == "local":
        shim_exec_local(real, "zig", rest)
    need_config("zig")
    if route == "remote-run":
        rc, _ = run_here(shlex.join(["zig"] + rest), {})
        return rc
    # remote-install: a local `zig build` leaves a binary for this computer in the prefix, so the
    # sandbox builds for it (unless a target is given) and the result is copied back to the prefix.
    build = rest[1:]
    steps, prefix, target = zig_build_parts(build)
    prefix = prefix or "zig-out"
    out = build_out(target or host_target())
    keep = []
    i = 0
    while i < len(build):  # the user's prefix is where the copy goes; the build uses OUT
        if build[i] in ("-p", "--prefix"):
            i += 2
            continue
        if not build[i].startswith("--prefix="):
            keep.append(build[i])
        i += 1
    if not target:
        keep = ["-Dtarget=%s" % host_target()] + keep
    say("zig build runs in this agent's sandbox%s; the result comes back to %s"
        % ("" if target else " for %s" % host_target(), prefix))
    rc, _ = run_here(shlex.join(["zig", "build", "--prefix", out] + keep), {})
    if rc != 0:
        return rc
    rc, results, _ = helper_call("tar", os.path.realpath(os.getcwd()), out)
    last = results[-1] if results else {}
    if rc != 0:
        die("sandbox: %s" % last.get("error", "exit %d" % rc))
    with tempfile.TemporaryDirectory() as tmp:
        tgz = os.path.join(tmp, "out.tgz")
        if subprocess.call(vercel("copy", "%s:%s" % (SANDBOX, last["tarball"]), tgz),
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) != 0:
            die("could not copy the build back from the sandbox")
        staging = os.path.join(tmp, "x")
        os.makedirs(staging)
        extract_plain(tgz, staging)
        src = os.path.join(staging, os.path.basename(out))
        dest = os.path.join(os.getcwd(), prefix) if not os.path.isabs(prefix) else prefix
        count = 0
        for dirpath, _dirs, files in os.walk(src):
            for name in files:
                rel = os.path.relpath(os.path.join(dirpath, name), src)
                os.makedirs(os.path.dirname(os.path.join(dest, rel)), exist_ok=True)
                shutil.copy2(os.path.join(dirpath, name), os.path.join(dest, rel))
                count += 1
    # OUT stays in the sandbox: the next build of the same target installs only what changed.
    say("copied %d %s to %s" % (count, "file" if count == 1 else "files", dest))
    return 0


def cmd_bun(args):
    real, rest = shim_args(args)
    route = bun_route(rest)
    if route != "local" and not project_allows_remote(os.getcwd()):
        route = "local"
    if os.environ.get("FXC_SHIM_DRYRUN"):
        print("bun %s -> %s" % (shlex.join(rest), route))
        return 0
    if route == "local":
        shim_exec_local(real, "bun", rest)
    need_config("bun")
    # In the sandbox: build the project's Linux binary first when it is a Zig project, because
    # E2E tests and drivers run it; install the nearest package.json's dependencies when missing.
    script = (
        'top=$(git rev-parse --show-toplevel 2>/dev/null || pwd); '
        'if [ -f "$top/build.zig" ]; then (cd "$top" && zig build) || exit $?; fi; '
        'd=$PWD; while [ "$d" != / ] && [ ! -f "$d/package.json" ]; do d=$(dirname "$d"); done; '
        'if [ -f "$d/package.json" ] && [ ! -d "$d/node_modules" ]; then '
        '(cd "$d" && (bun install --frozen-lockfile >/dev/null 2>&1 || bun install >/dev/null)) || exit $?; fi; '
        'exec ' + shlex.join(["bun"] + rest))
    rc, _ = run_here(script, {})
    return rc


def cmd_tla(args):
    """The sh, bash and python3 shims in extras/fx/shims call this for TLA+ runner scripts. The
    routing lives in extras/fx/tla.py."""
    path = os.path.join(HERE, "extras", "fx", "tla.py")
    if not os.path.isfile(path):
        die("the tla command needs extras/fx/tla.py", 127)
    spec = importlib.util.spec_from_file_location("fxc_tla", path)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod.main(sys.modules[__name__], args)


def extract_plain(tgz, dest):
    """Extracts regular files and folders only, and refuses paths that leave DEST."""
    root = os.path.realpath(dest)
    count = 0
    with tarfile.open(tgz, "r:gz") as tar:
        for m in tar.getmembers():
            target = os.path.realpath(os.path.join(root, m.name))
            if not (target == root or target.startswith(root + os.sep)):
                die("refusing unexpected path in the tarball: %r" % m.name)
            if m.isdir():
                os.makedirs(target, exist_ok=True)
            elif m.isreg():
                os.makedirs(os.path.dirname(target), exist_ok=True)
                with tar.extractfile(m) as src, open(target, "wb") as out:
                    shutil.copyfileobj(src, out)
                os.chmod(target, m.mode & 0o755 | 0o600)
                count += 1
    return count


# --------------------------------------------------------------------------- init and the rest

def ask(question, default):
    if not sys.stdin.isatty():
        die("%s: not given; run `fx-cloud init --team TEAM --project PROJECT`" % question, 2)
    try:
        answer = input("%s%s: " % (question, " [%s]" % default if default else "")).strip()
    except EOFError:
        answer = ""
    return answer or default or ""


def cmd_init(args):
    """Writes the settings file: the Vercel team and project, after a check that the Vercel CLI
    can reach them."""
    global CFG, CONFIG_FOUND
    flags, rest = take_flags(args, (), valued=("--team", "--project", "--prefix"))
    if rest:
        die("usage: fx-cloud init [--team TEAM] [--project PROJECT] [--prefix PREFIX]", 2)
    try:
        with open(CONFIG_FILE) as f:
            current = json.load(f)
    except FileNotFoundError:
        current = {}
    except (OSError, ValueError) as e:
        die("cannot read %s: %s; fix it or remove it" % (short(CONFIG_FILE), e))
    if not isinstance(current, dict):
        die("%s must hold a JSON object; fix it or remove it" % short(CONFIG_FILE))
    who = subprocess.run(["vercel", "whoami"], capture_output=True, text=True)
    user = (who.stdout.strip().splitlines() or [""])[-1].strip()
    if who.returncode != 0 or not user:
        sys.stderr.write((who.stdout + who.stderr)[-1000:])
        die("the Vercel CLI is not logged in; run `vercel login`, then `fx-cloud init` again")
    say("the Vercel CLI is logged in as %s" % user)
    team = flags.get("--team") or ask("Vercel team (the slug in vercel.com/<team>)", current.get("team"))
    project = flags.get("--project") or ask("Vercel project for the sandboxes", current.get("project"))
    prefix = flags.get("--prefix") or current.get("prefix") or DEFAULTS["prefix"]
    if not (team or "").strip() or not (project or "").strip():
        die("fx-cloud init needs a team and a project: fx-cloud init --team TEAM --project PROJECT", 2)
    new = dict(DEFAULTS)
    new.update(current)
    new.update(team=team, project=project, prefix=prefix)
    try:
        CFG = check_config({k: v for k, v in new.items() if k in DEFAULTS}, required=True)
    except ConfigError as e:
        die(str(e))
    p = subprocess.run(vercel("list", "--limit", "1"), capture_output=True, text=True)
    if p.returncode != 0:
        sys.stderr.write((p.stdout + p.stderr)[-1500:])
        die("cannot list the sandboxes of %s/%s. Check the team slug and the project name. To make the "
            "project, run: vercel project add %s --scope %s" % (team, project, project, team))
    say("%s/%s has Vercel Sandbox access" % (team, project))
    write_json(CONFIG_FILE, new)
    CONFIG_FOUND = True
    say("wrote %s" % short(CONFIG_FILE))
    if os.path.exists(BASE_FILE) and not read_base():
        say("note: the base snapshot in %s is for other settings; `fx-cloud base` makes one for these"
            % short(BASE_FILE))
    print("Next steps:")
    if not read_base():
        print("  fx-cloud base          build the base snapshot (about a minute; 5 to 12 with warm builds)")
    print("  fx-cloud login         optional: sign the base in to GitHub (private repositories) and fx")
    print("  fx-cloud run <command> from a project folder, for example: fx-cloud run zig build test")
    print("Other settings, such as vcpus, idle_minutes, warm and setup_hook, are in %s." % short(CONFIG_FILE))
    return 0


def cmd_shell(args):
    global SANDBOX
    if "--base" in args:
        SANDBOX = (read_base() or {}).get("sandbox") or die("there is no base yet; run `fx-cloud base`")
        return subprocess.call(vercel("connect", *TERM_ENV, SANDBOX))
    rc, _ = run_here("true", {})  # this agent's sandbox, with this folder copied
    if rc != 0:
        return rc
    return subprocess.call(vercel("connect", "--workdir", os.path.realpath(os.getcwd()), *TERM_ENV, SANDBOX))


def cmd_extend(args):
    if len(args) != 1:
        die("usage: fx-cloud extend <duration>, for example 1h", 2)
    if use_sandbox(folder_root(os.getcwd()), create=False) is None:
        die("this agent has no sandbox for this folder")
    return subprocess.call(vercel("extend", SANDBOX, args[0]))


def cmd_status(_args):
    print("settings: %s" % short(CONFIG_FILE))
    print("team / project: %s / %s; sandbox names start with %s" % (CFG["team"], CFG["project"], CFG["prefix"]))
    base = read_base()
    if base:
        print("base snapshot: %s, made %s ago in %s%s" % (base["snapshot"], ago(base["created"]), base["sandbox"],
                                                          "" if base.get("warm", True) else " (no warm builds)"))
    else:
        print("base snapshot: none; run `fx-cloud base`")
    print("agent sandboxes known on this Mac: %d (`fx-cloud ls` lists them)" % len(all_entries()))
    print("each: %d vCPUs, ends after %d idle minutes; a note when more than %d are open"
          % (CFG["vcpus"], CFG["idle_minutes"], CFG["max_agents"]))
    if CFG["local_only"]:
        print("local only (the shims run these here): %s" % ", ".join(CFG["local_only"]))
    if CFG["warm"]:
        print("warm repositories: %s" % ", ".join(w["repo"] for w in CFG["warm"]))
    if CFG["setup_hook"]:
        print("setup hook: %s" % short(CFG["setup_hook"]))
    return 0


COMMANDS = {
    "init": cmd_init, "run": cmd_run, "push": cmd_push, "agent": cmd_agent, "pull": cmd_pull,
    "macos-build": cmd_macos_build, "base": cmd_base, "setup": cmd_base, "login": cmd_login,
    "shell": cmd_shell, "extend": cmd_extend, "stop": cmd_done, "status": cmd_status,
    "done": cmd_done, "ls": cmd_ls, "gc": cmd_gc, "zig": cmd_zig, "bun": cmd_bun, "tla": cmd_tla,
}
SHIM_COMMANDS = ("zig", "bun", "tla")  # they need the settings only when they send work away


def main(argv):
    if argv and argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    if not argv or argv[0] not in COMMANDS:
        print(__doc__.strip(), file=sys.stderr)
        if argv:
            say("unknown command %s" % argv[0])
        return 2
    cmd = argv[0]
    if cmd not in SHIM_COMMANDS and shutil.which("vercel") is None:
        die("the Vercel CLI is missing; install it with `npm i -g vercel`, then run `vercel login`")
    if cmd != "init":
        setup_config(required=cmd not in SHIM_COMMANDS)
    return COMMANDS[cmd](argv[1:]) or 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        print(file=sys.stderr)
        say("stopped")
        sys.exit(130)
