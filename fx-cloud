def is_fx_cloud_shim(path):
    try:
        with open(path, "rb") as f:
            head = f.read(4096)
    except OSError:
        return False
    return b"exec fx-cloud " in head


def real_tool(name):
    """The first NAME in PATH that is not one of fx-cloud's shims."""
    for d in os.environ.get("PATH", "").split(os.pathsep):
        path = os.path.join(d, name) if d else ""
        if path and os.path.isfile(path) and os.access(path, os.X_OK) and not is_fx_cloud_shim(path):
            return path
    return None


def quiet_output(argv):
    """ARGV's stdout without its last newline, or "" when it fails."""
    try:
        p = subprocess.run(argv, capture_output=True, text=True, timeout=30,
                           env=dict(os.environ, FXC_LOCAL="1"))
    except (OSError, subprocess.SubprocessError):
        return ""
    return p.stdout.strip() if p.returncode == 0 else ""


def mac_facts():
    """What the base takes from this Mac: the home folder, the Zig, Bun and fx it uses, and the
    git name and email."""
    facts = {"home": HOME, "zig": "", "bun": "", "fx": False, "fx_channel": "", "git_name": "",
             "git_email": ""}
    for tool, args in (("zig", ["version"]), ("bun", ["--version"])):
        path = real_tool(tool)
        version = quiet_output([path] + args) if path else ""
        if re.fullmatch(r"\d+\.\d+\.\d+[0-9A-Za-z.+-]*", version):
            facts[tool] = version
    fx = real_tool("fx")
    if fx:
        facts["fx"] = True
        try:
            channel = json.loads(quiet_output([fx, "status", "--json"]) or "{}").get("build_channel") or ""
        except (ValueError, AttributeError):
            channel = ""
        facts["fx_channel"] = channel if re.fullmatch(r"[a-z]+", channel) else ""
    facts["git_name"] = quiet_output(["git", "config", "--get", "user.name"])
    facts["git_email"] = quiet_output(["git", "config", "--get", "user.email"])
    return facts


def strip_rule_block(text):
    """TEXT without the fx-cloud rule block that install.sh --add-rule adds."""
    while RULE_START in text:
        start = text.index(RULE_START)
        end = text.find(RULE_END, start)
        end = len(text) if end < 0 else end + len(RULE_END)
        text = text[:start].rstrip("\n") + "\n\n" + text[end:].lstrip("\n")
    return text.strip("\n") + "\n" if text.strip() else ""


def add_tree(tar, root, arc_prefix="", skip_top=()):
    """Adds a skills folder, following symlinks and skipping broken ones and build clutter."""
    for dirpath, dirnames, filenames in os.walk(root, followlinks=True):
        dirnames[:] = [d for d in dirnames if d not in SKILL_SKIP and not (dirpath == root and d in skip_top)]
        for name in filenames:
            if name in SKILL_SKIP:
                continue
            path = os.path.join(dirpath, name)
            if not os.path.exists(path):
                continue
            arc = os.path.join(arc_prefix, os.path.relpath(path, root))
            info = tar.gettarinfo(os.path.realpath(path), arcname=arc)
            if info is None or not info.isreg():
                continue
            info.uid = info.gid = 0
            info.uname = info.gname = ""
            with open(path, "rb") as f:
                tar.addfile(info, f)


def build_bundle(tmp, facts):
    """The setup bundle: the remote scripts, what the base takes from this Mac, the warm list, the
    skills and rule files, and the setup hook."""
    b = os.path.join(tmp, "fxc")
    shutil.copytree(os.path.join(HERE, "remote"), os.path.join(b, "remote"))
    mac = os.path.join(b, "mac")
    os.makedirs(os.path.join(mac, "rules"))
    write_json(os.path.join(mac, "facts.json"), facts)
    for i, w in enumerate(CFG["warm"]):
        d = os.path.join(mac, "warm", "%02d" % i)
        os.makedirs(d)
        with open(os.path.join(d, "repo"), "w") as f:
            f.write(w["repo"] + "\n")
        with open(os.path.join(d, "run"), "w") as f:
            f.write("".join(c + "\n" for c in w["run"]))
    settings_path = os.path.join(HOME, ".fx", "settings.json")
    if facts["fx"] and os.path.isfile(settings_path):
        try:
            with open(settings_path) as f:
                settings = json.load(f)
            write_json(os.path.join(mac, "fx-settings.json"),
                       {k: settings[k] for k in FX_SETTINGS_KEYS if k in settings})
        except (OSError, ValueError, TypeError):
            say("note: could not read %s; the base uses fx's default settings" % short(settings_path))
    for tool, fname in RULE_FILES:
        if not os.path.isdir(os.path.join(HOME, "." + tool)) and not (tool == "fx" and facts["fx"]):
            continue
        text = ""
        if CFG["copy_skills"]:
            try:
                with open(os.path.join(HOME, "." + tool, fname), errors="replace") as f:
                    text = strip_rule_block(f.read())
            except OSError:
                pass
        with open(os.path.join(mac, "rules", "%s-%s" % (tool, fname)), "w") as f:
            f.write(text)
    if CFG["copy_skills"]:
        skills = os.path.join(b, "skills")
        os.makedirs(skills)
        for root in SKILL_ROOTS:
            src = os.path.join(HOME, "." + root, "skills")
            if os.path.isdir(src):
                with tarfile.open(os.path.join(skills, root + ".tgz"), "w:gz") as tar:
                    add_tree(tar, src, skip_top=("fx-cloud",))  # this skill is for the Mac only
    if CFG["setup_hook"]:
        os.makedirs(os.path.join(b, "hook"))
        shutil.copy(CFG["setup_hook"], os.path.join(b, "hook", "setup-hook"))
    bundle = os.path.join(tmp, "fxc-bundle.tgz")
    with tarfile.open(bundle, "w:gz") as tar:
        tar.add(b, arcname="fxc")
    return bundle


# The sign-ins that a new base takes over from the old one, relative to the sandbox home.
CRED_FILES = [".fx/auth.json", ".fx/settings.json", ".config/gh/hosts.yml", ".config/gh/config.yml"]


def sandbox_named(name):
    p = subprocess.run(vercel("list", "--all", "--name-prefix", name), capture_output=True, text=True)
    return p.returncode == 0 and any(r[0] == name for r in parse_sandbox_rows(p.stdout))


def take_credentials(src, tmp):
    """Copies the sign-in files of sandbox SRC into TMP, a private folder. Returns the tarball."""
    global SANDBOX
    SANDBOX = src
    files = " ".join(shlex.quote(f) for f in CRED_FILES)
    p = subprocess.run(remote_cmd("cd ~ && ls -d %s 2>/dev/null | tar -czf /tmp/fxc-creds.tgz -T - && echo ok" % files),
                       capture_output=True, text=True)
    if p.returncode != 0 or "ok" not in p.stdout:
        return None
    tgz = os.path.join(tmp, "creds.tgz")
    rc = subprocess.call(vercel("copy", "%s:/tmp/fxc-creds.tgz" % src, tgz),
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(remote_cmd("rm -f /tmp/fxc-creds.tgz"), capture_output=True)
    return tgz if rc == 0 else None


def write_base(base):
    write_json(BASE_FILE, base)


def snapshot_base(name, t0, warm):
    """Snapshots the base sandbox NAME (this stops it) and makes the snapshot the new base."""
    say("taking the base snapshot; this stops the base sandbox")
    p = subprocess.run(vercel("snapshot", name, "--stop", "--expiration", "0"), capture_output=True, text=True)
    m = re.search(r"snap_[A-Za-z0-9]+", p.stdout + p.stderr)
    if p.returncode != 0 or not m:
        sys.stderr.write((p.stdout + p.stderr)[-2000:])
        die("the snapshot failed; new agent sandboxes still use the old base")
    cur = read_base() or {}
    same = cur.get("sandbox") == name
    old_bases = list(cur.get("old_bases", []))
    retired = list(cur.get("retired", []))
    if cur and not same:
        old_bases.append(cur["sandbox"])  # cmd_base removes it next
        retired += cur.get("snapshots") or [cur["snapshot"]]
    write_base({"snapshot": m.group(0), "created": time.time(), "sandbox": name, "warm": warm,
                "team": CFG["team"], "project": CFG["project"], "prefix": CFG["prefix"],
                "snapshots": (cur.get("snapshots", []) if same else []) + [m.group(0)],
                "old_bases": old_bases, "retired": retired})
    say("base snapshot %s is ready after %.0f s; new agent sandboxes start from it" % (m.group(0), time.time() - t0))


def snapshot_status(snap):
    """The STATUS of snapshot SNAP (created, deleted, ...), "gone" when the API does not know it,
    or None when the CLI fails otherwise."""
    q = subprocess.run(vercel(("snapshots", "get"), snap), capture_output=True, text=True)
    for line in q.stdout.splitlines():
        w = line.split()
        if len(w) >= 2 and w[0] == snap:
            return w[1]
    text = (q.stdout + q.stderr).lower()
    return "gone" if "not found" in text or "404" in text else None


def delete_snapshot(snap):
    """Deletes snapshot SNAP. True when it is gone."""
    p = subprocess.run(vercel(("snapshots", "delete"), snap), capture_output=True, text=True)
    return p.returncode == 0 or snapshot_status(snap) in ("deleted", "gone")


def clean_old_bases(agents, quiet=False):
    """Removes old base sandboxes, and the snapshots of old bases that no agent sandbox of this
    prefix still uses. AGENTS is name -> (status, snapshot)."""
    with file_lock(os.path.join(STATE_DIR, "base.lock"), wait=False) as held:
        if not held:
            return  # a base build runs; it changes base.json
        base = read_base()
        if not base or not (base.get("old_bases") or base.get("retired")):
            return
        used = {snap for _, snap in agents.values() if snap}
        old_bases = []
        for n in base.get("old_bases", []):
            if not is_base_name(n) or n == base["sandbox"]:
                continue
            p = subprocess.run(vercel("rm", "--delete-orphan-snapshots", n), capture_output=True, text=True)
            if p.returncode != 0 and "not found" not in (p.stdout + p.stderr).lower():
                old_bases.append(n)
            elif not quiet:
                say("removed the old base sandbox %s" % n)
        retired = [s for s in base.get("retired", []) if s in used or not delete_snapshot(s)]
        base["old_bases"], base["retired"] = old_bases, retired
        write_base(base)


