def cmd_shell(args):
    global SANDBOX
    if "--base" in args:
        SANDBOX = (read_base() or {}).get("sandbox") or die("there is no base yet; run `fx-cloud base`")
        return subprocess.call(vercel("connect", "--workdir", WS, *TERM_ENV, SANDBOX))
    rc, _ = run_here("true", {})  # this agent's sandbox, with this folder copied
    if rc != 0:
        return rc
    return subprocess.call(vercel("connect", "--workdir", os.path.realpath(os.getcwd()), *TERM_ENV, SANDBOX))


def cmd_extend(args):
    if len(args) != 1:
        die("usage: fx-cloud extend <duration>, for example 2h", 2)
    if use_sandbox(folder_root(os.getcwd()), create=False) is None and not (LEGACY or SANDBOX == FALLBACK):
        die("this agent has no sandbox for this folder")
    return subprocess.call(vercel("extend", SANDBOX, args[0]))


def cmd_stop(args):
    if not LEGACY:
        return cmd_done(args)  # an agent sandbox keeps no files when it stops, so remove it
    return subprocess.call(vercel("stop", SANDBOX))


def cmd_status(_args):
    if not LEGACY:
        base = read_base()
        if base:
            print("base snapshot: %s, made %s ago in %s" % (base["snapshot"], ago(base["created"]), base["sandbox"]))
        else:
            print("base snapshot: none; run fx-cloud base (until then, commands use %s)" % FALLBACK)
        entries = all_entries()
        print("agent sandboxes known on this Mac: %d (fx-cloud ls lists them)" % len(entries))
        print("each: %s vCPUs, ends after %d idle minutes; at most %d before a warning"
              % (AGENT_VCPUS, IDLE_MIN, MAX_AGENTS))
        print("Mac fx: %s" % json.dumps(local_build()))
        return 0
    p = subprocess.run(vercel("list"), capture_output=True, text=True)
    rows = [l for l in p.stdout.splitlines() if l.split()[:1] in (["NAME"], [SANDBOX])]
    print("\n".join(rows) if rows else "sandbox %s not found; run fx-cloud setup" % SANDBOX)
    if not any(l.split()[:1] == [SANDBOX] for l in rows):
        return 1
    print("Mac fx:     %s" % json.dumps(local_build()))
    remote = run_remote("fx status --json", check=False).stdout
    try:
        d = json.loads(remote)
        print("sandbox fx: %s" % json.dumps({"channel": d.get("build_channel"), "revision": d.get("build_revision")}))
    except ValueError:
        print("sandbox fx: unknown")
    return 0


