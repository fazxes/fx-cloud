FIXED_IDENTITY = {
    "GIT_AUTHOR_NAME": "fx-cloud", "GIT_AUTHOR_EMAIL": "fx-cloud@localhost",
    "GIT_AUTHOR_DATE": "1700000000 +0000", "GIT_COMMITTER_NAME": "fx-cloud",
