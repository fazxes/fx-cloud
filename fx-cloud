}


def fallback_removed():
    return os.path.exists(os.path.join(HOME, ".config", "fx-cloud", FALLBACK + "-removed"))


def main(argv):
    global LEGACY, SANDBOX
    if LEGACY == FALLBACK and fallback_removed():
        say("note: the shared sandbox %s is removed, so this uses the agent's own sandbox; "
            "leave out FXC_SANDBOX" % FALLBACK)
        LEGACY = SANDBOX = ""
    if argv and argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    if shutil.which("vercel") is None:
        die("the vercel CLI is missing; install it with: brew install vercel-cli")
    if argv and argv[0] in COMMANDS:
        return COMMANDS[argv[0]](argv[1:]) or 0
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        print(file=sys.stderr)
        say("stopped")
        sys.exit(130)
